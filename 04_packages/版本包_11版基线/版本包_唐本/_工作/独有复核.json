  "文本": "阴易病已后劳复第七  七证  方四首  ……………………………  356"
 },
 {
  "iid": "唐本-独-0032",
  "页": 313,
  "类": "前置",
  "文本": "伤寒上"
 },
 {
  "iid": "唐本-独-0033",
  "页": 313,
  "类": "前置",
  "文本": "论曰：伤寒热病，自古有之，名贤浚①哲，多所防御。至于仲景，特有神功。寻思旨趣，莫测其致，所以医人未能钻仰。尝见太医疗伤寒，惟大青、知母等诸冷物投之，极与仲景本意相反。汤药虽行，百无一效。伤其如此，遂披《伤寒大论》，鸠集要妙。以为其方，行之以"
 },
 {
  "iid": "唐本-独-0034",
  "页": 313,
  "类": "独立",
  "文本": "太阳病用桂枝汤法第一  五十七证  方五首"
 },
 {
  "iid": "唐本-独-0035",
  "页": 313,
  "类": "独立",
  "文本": "论曰：伤寒与痉③病、湿病及热喝相滥，故叙而论之。"
 },
 {
  "iid": "唐本-独-0036",
  "页": 313,
  "类": "独立",
  "文本": "太阳病，发热无汗，而反恶寒，是为刚痉。"
 },
 {
  "iid": "唐本-独-0037",
  "页": 313,
  "类": "独立",
  "文本": "太阳病，发其汗，因致痉。"
 },
 {
  "iid": "唐本-独-0038",
  "页": 314,
  "类": "独立",
  "文本": "病者，身热足寒，颈项强，恶寒，时头热面赤，目脉赤，独头动摇，是为痉。"
 },
 {
  "iid": "唐本-独-0039",
  "页": 314,
  "类": "碎片",
  "文本": "上① 件痉状。"
 },
 {
  "iid": "唐本-独-0040",
  "页": 314,
  "类": "独立",
  "文本": "病者，一身尽疼，烦，日晡即剧，此为风湿，汗出所致也②。"
 },
 {
  "iid": "唐本-独-0041",
  "页": 314,
  "类": "独立",
  "文本": "湿家之为病，一身尽疼，发热，而身色似熏黄也③。"
 },
 {
  "iid": "唐本-独-0042",
  "页": 314,
  "类": "独立",
  "文本": "湿家之为病，其人但头汗出而背强，欲得被覆。若下之早，则哕，或胸满，小便利④，舌上如胎，此为丹田有热，胸上有寒，渴欲饮则不能饮，而口燥也。"
 },
 {
  "iid": "唐本-独-0043",
  "页": 314,
  "类": "独立",
  "文本": "湿家下之，额上汗出，微喘，小便利者死；下利不止者，亦死。"
 },
 {
  "iid": "唐本-独-0044",
  "页": 314,
  "类": "独立",
  "文本": "问曰：病风湿相搏，身体疼痛，法当汗出而解。值天阴雨，溜下不止。师云：此可发汗，面其病不愈者⑤，何故？ 答曰：发其汗，汗大出者，但风气去，湿气续在，是故不愈。若治风湿者，发其汗，微微似欲出汗者，则风湿俱去也。"
 },
 {
  "iid": "唐本-独-0045",
  "页": 314,
  "类": "独立",
  "文本": "病人喘，头痛鼻塞而烦，其脉大，自能饮食，腹中独和，无病。病在头，中寒湿，故鼻塞，内药鼻中，即愈。"
 },
 {
  "iid": "唐本-独-0046",
  "页": 314,
  "类": "碎片",
  "文本": "上件湿状。"
 },
 {
  "iid": "唐本-独-0047",
  "页": 314,
  "类": "独立",
  "文本": "太阳中热⑥，暍是也，其人汗出恶寒，身热而渴也。"
 },
 {
  "iid": "唐本-独-0048",
  "页": 314,
  "类": "独立",
  "文本": "太阳中喝，身热疼重，而脉微弱，此以夏月伤冷水⑦，水行皮肤中也⑧。"
 },
 {
  "iid": "唐本-独-0049",
  "页": 314,
  "类": "独立",
  "文本": "太阳中喝，发热恶寒，身重而疼痛，其脉弦细芤迟，小便已，洒"
 },
 {
  "iid": "唐本-独-0050",
  "页": 314,
  "类": "碎片",
  "文本": "--------------------------------------------------"
 },
 {
  "iid": "唐本-独-0051",
  "页": 315,
  "类": "独立",
  "文本": "然手足逆冷，小有劳热①，口前开，板齿燥②。若发其汗，恶寒则甚；加温针，发热益甚；数下之，淋复甚。"
 },
 {
  "iid": "唐本-独-0052",
  "页": 315,
  "类": "碎片",
  "文本": "上件谒状。"
 },
 {
  "iid": "唐本-独-0053",
  "页": 315,
  "类": "重出",
  "宋本": 1,
  "覆盖": 0.857,
  "文本": "太阳之为病，头项强痛而恶寒。"
 },
 {
  "iid": "唐本-独-0054",
  "页": 315,
  "类": "独立",
  "文本": "太阳病，其脉浮。"
 },
 {
  "iid": "唐本-独-0055",
  "页": 315,
  "类": "独立",
  "文本": "太阳中风，发热而恶寒③。"
 },
 {
  "iid": "唐本-独-0056",
  "页": 315,
  "类": "独立",
  "文本": "太阳病，三四日不吐下，见杄④ 乃汗之⑤。"
 },
 {
  "iid": "唐本-独-0057",
  "页": 316,
  "类": "重出",
  "宋本": 24,
  "覆盖": 0.897,
  "文本": "太阳病，初服桂枝汤，而反烦不解者，当先刺风池、风府，乃却与桂枝汤则愈。"
 },
 {
  "iid": "唐本-独-0058",
  "页": 316,
  "类": "重出",
  "宋本": 44,
  "覆盖": 0.87,
  "文本": "太阳病，有外证未解，不可下之，下之为逆，解外④宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0059",
  "页": 316,
  "类": "重出",
  "宋本": 45,
  "覆盖": 0.824,
  "文本": "太阳病，先发汗不解而下之，其脉浮⑤，不愈。浮为在外，而反下之，故令不愈。今脉浮，故在外⑥，当解其外则愈，宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0060",
  "页": 316,
  "类": "独立",
  "文本": "病常自汗出⑦，此为荣气和，卫气不和故也。荣行脉中，卫行脉外，复发其汗，卫和则愈，宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0061",
  "页": 316,
  "类": "重出",
  "宋本": 54,
  "覆盖": 0.939,
  "文本": "病人藏无他病，时发热⑧，自汗出而不愈⑨，此卫气不和也。先其时发汗愈⑩。宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0062",
  "页": 316,
  "类": "重出",
  "宋本": 56,
  "覆盖": 0.776,
  "文本": "伤寒，不大便六七日，头痛有热，与承气汤。其大便反青⑪，此为不在里，故在表也，当发其汗。头痛者必衄。宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0063",
  "页": 317,
  "类": "重出",
  "宋本": 57,
  "覆盖": 0.913,
  "文本": "伤寒，发汗已解，半日许复烦①，其脉浮数②，可复发其汗，宜服桂枝汤③。"
 },
 {
  "iid": "唐本-独-0064",
  "页": 317,
  "类": "独立",
  "文本": "太阳病未解，其脉阴阳俱停·作微，必先振汗出而解，但阳微者，先汗之而解，宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0065",
  "页": 317,
  "类": "独立",
  "文本": "太阳病未解，热结膀胱，其人如狂，其血必自下，下者即愈。其外未解，尚未可攻，当先解其外，宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0066",
  "页": 317,
  "类": "重出",
  "宋本": 20,
  "覆盖": 0.97,
  "文本": "太阳病，发其汗，遂漏而不止，其人恶风，小便难，四肢微急，难以屈伸，桂枝加附子汤主之。桂枝中加附子一枚，炮，即是。"
 },
 {
  "iid": "唐本-独-0067",
  "页": 317,
  "类": "独立",
  "文本": "太阳病，下之，其脉促，胸满者，桂枝去芍药汤主之。若微寒者，桂枝去芍药加附子汤主之。桂枝去芍药，中加附子一枚，即是。"
 },
 {
  "iid": "唐本-独-0068",
  "页": 319,
  "类": "独立",
  "文本": "太阳病用麻黄汤法第二 一十六证 方四首"
 },
 {
  "iid": "唐本-独-0069",
  "页": 319,
  "类": "重出",
  "宋本": 3,
  "覆盖": 0.929,
  "文本": "太阳病，或已发热，或未发热，必恶寒，体痛，呕逆，脉阴阳俱紧，为伤寒。"
 },
 {
  "iid": "唐本-独-0070",
  "页": 319,
  "类": "独立",
  "文本": "伤寒一日，太阳脉弱，至四日，太阴脉大。"
 },
 {
  "iid": "唐本-独-0071",
  "页": 319,
  "类": "重出",
  "宋本": 4,
  "覆盖": 0.929,
  "文本": "伤寒一日，太阳受之，脉若静者，为不传。颇欲呕，若躁烦，脉数急者，乃为传。"
 },
 {
  "iid": "唐本-独-0072",
  "页": 319,
  "类": "独立",
  "文本": "伤寒，其二阳证不见，此为不传。"
 },
 {
  "iid": "唐本-独-0073",
  "页": 319,
  "类": "独立",
  "文本": "太阳病，头痛发热，身疼，腰痛，骨节疼，恶风，无汗而喘，麻黄汤主之。"
 },
 {
  "iid": "唐本-独-0074",
  "页": 319,
  "类": "重出",
  "宋本": 36,
  "覆盖": 0.947,
  "文本": "太阳与阳明合病，喘而胸满，不可下也，宜麻黄汤。"
 },
 {
  "iid": "唐本-独-0075",
  "页": 319,
  "类": "独立",
  "文本": "病十日已去，其脉浮细，嗜卧，此为外解。设胸满胁痛，与小柴胡汤；浮者，麻黄汤主之。"
 },
 {
  "iid": "唐本-独-0076",
  "页": 319,
  "类": "重出",
  "宋本": 46,
  "覆盖": 0.949,
  "文本": "太阳病，脉浮紧，无汗而发热，其身疼痛，八九日不解，其表证仍在，此当发其汗。服药微除，其人发烦，目瞑，增剧者必衄①，衄乃解。所以然者，阳气重故也，宜麻黄汤。"
 },
 {
  "iid": "唐本-独-0077",
  "页": 319,
  "类": "重出",
  "宋本": 52,
  "覆盖": 1.0,
  "文本": "脉浮而数者，可发其汗，宜麻黄汤。"
 },
 {
  "iid": "唐本-独-0078",
  "页": 319,
  "类": "独立",
  "文本": "太阳病，下之微喘者，外未解故也，宜麻黄汤。一云：桂枝汤。"
 },
 {
  "iid": "唐本-独-0079",
  "页": 319,
  "类": "碎片",
  "文本": "麻黄汤方："
 },
 {
  "iid": "唐本-独-0080",
  "页": 320,
  "类": "独立",
  "文本": "半，去滓，温服八合，覆取微似汗，不须啜粥①，余如桂枝法。"
 },
 {
  "iid": "唐本-独-0081",
  "页": 320,
  "类": "独立",
  "文本": "太阳病用青龙汤法第三 四证 方二首"
 },
 {
  "iid": "唐本-独-0082",
  "页": 321,
  "类": "独立",
  "文本": "太阳病用柴胡汤法第四 一十五证 方七首"
 },
 {
  "iid": "唐本-独-0083",
  "页": 322,
  "类": "重出",
  "宋本": 148,
  "覆盖": 0.898,
  "文本": "伤寒五六日，头汗出，微恶寒，手足冷，心下满，口不欲食，大便坚，其脉细，此为阳微结，必有表，复有里②。沉则为病在里，汗出亦为阳微。假令纯阴结，不得有外证，悉人在于里，此为半在外，半在里。脉虽沉紧，不得为少阴。所以然者，阴不得有汗。今头大汗出，"
 },
 {
  "iid": "唐本-独-0084",
  "页": 323,
  "类": "独立",
  "文本": "柴胡加大黄芒消桑螵蛸汤方①："
 },
 {
  "iid": "唐本-独-0085",
  "页": 323,
  "类": "独立",
  "文本": "上以前七味，以水七升，下芒消三合，大黄四分，桑螵蛸五枚，煮取一升半，去滓，温服五合，微下即愈。本云：柴胡汤，再服以解其外，余二升，加芒消、大黄、桑螵蛸也。"
 },
 {
  "iid": "唐本-独-0086",
  "页": 323,
  "类": "重出",
  "宋本": 107,
  "覆盖": 0.85,
  "文本": "伤寒八九日，下之，胸满烦惊，小便不利，谵语，一身不可转侧，柴胡加龙骨牡蛎汤主之。方："
 },
 {
  "iid": "唐本-独-0087",
  "页": 323,
  "类": "独立",
  "文本": "伤寒六七日，发热，微恶寒，支节烦疼，微呕，心下支结，外证未去者，宜柴胡桂枝汤。"
 },
 {
  "iid": "唐本-独-0088",
  "页": 323,
  "类": "独立",
  "文本": "发汗多，亡阳狂语者，不可下，以为可与柴胡桂枝汤，和其荣卫，以通津液后，自愈。方："
 },
 {
  "iid": "唐本-独-0089",
  "页": 323,
  "类": "独立",
  "文本": "伤寒五六日，其人已发汗，而复下之，胸胁满，微结，小便不利，渴而不呕，但头汗出，往来寒热而烦，此为未解，柴胡桂枝干姜汤主之。方："
 },
 {
  "iid": "唐本-独-0090",
  "页": 324,
  "类": "独立",
  "文本": "服。初服微烦，汗出愈。"
 },
 {
  "iid": "唐本-独-0091",
  "页": 324,
  "类": "独立",
  "文本": "太阳病，过经十余日，反再三下之，后四五日，柴胡证续在，先与小柴胡汤，呕止小安，其人郁郁微烦者，为未解，与大柴胡汤下者止①。"
 },
 {
  "iid": "唐本-独-0092",
  "页": 324,
  "类": "独立",
  "文本": "伤寒十余日，邪气结在里，欲复往来寒热，当与大柴胡汤。"
 },
 {
  "iid": "唐本-独-0093",
  "页": 324,
  "类": "重出",
  "宋本": 165,
  "覆盖": 0.917,
  "文本": "伤寒发热，汗出不解，心中痞坚，呕吐下利者，大柴胡汤主之。"
 },
 {
  "iid": "唐本-独-0094",
  "页": 324,
  "类": "独立",
  "文本": "病人表里无证，发热七八日，虽脉浮数，可下之，宜大柴胡汤。方："
 },
 {
  "iid": "唐本-独-0095",
  "页": 324,
  "类": "独立",
  "文本": "太阳病用承气汤法第五 九证 方四首"
 },
 {
  "iid": "唐本-独-0096",
  "页": 324,
  "类": "独立",
  "文本": "发汗后，恶寒者，虚故也；不恶寒，但热者，实也，当和其胃气，宜小承气汤。"
 },
 {
  "iid": "唐本-独-0097",
  "页": 324,
  "类": "重出",
  "宋本": 94,
  "覆盖": 0.792,
  "文本": "太阳病未解，其脉阴阳俱停一作微，必先振汗出而解，但阳微者，先汗出而解；阴微者，先下之而解，宜承气汤。一云：大柴胡汤。"
 },
 {
  "iid": "唐本-独-0098",
  "页": 324,
  "类": "独立",
  "文本": "太阳病，过经十余日，心下温温欲吐，而胸中痛，大便反溏，其腹微满，郁郁微烦，先时自极吐下者，宜承气汤。"
 },
 {
  "iid": "唐本-独-0099",
  "页": 324,
  "类": "重出",
  "宋本": 220,
  "覆盖": 0.912,
  "文本": "二阳并病，太阳证罢，但发潮热，手足漐漐汗出，大便难，谵语者，下之愈，宜承气汤。"
 },
 {
  "iid": "唐本-独-0100",
  "页": 324,
  "类": "碎片",
  "文本": "————————"
 },
 {
  "iid": "唐本-独-0101",
  "页": 325,
  "类": "独立",
  "文本": "伤寒吐后，腹满者，承气汤主之。"
 },
 {
  "iid": "唐本-独-0102",
  "页": 325,
  "类": "重出",
  "宋本": 250,
  "覆盖": 0.828,
  "文本": "太阳病，吐下、发汗后，微烦，小便数，大便因坚，可与小承气汤，和之则愈。承气汤方："
 },
 {
  "iid": "唐本-独-0103",
  "页": 325,
  "类": "碎片",
  "文本": "又方："
 },
 {
  "iid": "唐本-独-0104",
  "页": 325,
  "类": "独立",
  "文本": "太阳病用陷胸汤法第六 三十一证 方一十六首"
 },
 {
  "iid": "唐本-独-0105",
  "页": 326,
  "类": "碎片",
  "文本": "大陷胸丸方："
 },
 {
  "iid": "唐本-独-0106",
  "页": 327,
  "类": "碎片",
  "文本": "大陷胸汤方："
 },
 {
  "iid": "唐本-独-0107",
  "页": 327,
  "类": "碎片",
  "文本": "五苓散方："
 },
 {
  "iid": "唐本-独-0108",
  "页": 327,
  "类": "独立",
  "文本": "桔梗十八铢 巴豆六铢，去皮心，熬赤黑，研如脂 贝母十八铢"
 },
 {
  "iid": "唐本-独-0109",
  "页": 331,
  "类": "独立",
  "文本": "太阳病杂疗法第七  二十证  方一十三首"
 },
 {
  "iid": "唐本-独-0110",
  "页": 331,
  "类": "重出",
  "宋本": 74,
  "覆盖": 0.879,
  "文本": "中风发热，六七日不解而烦，有表里证，渴欲饮水，水入而吐，此为水逆，五苓散主之。方见结胸门中。"
 },
 {
  "iid": "唐本-独-0111",
  "页": 331,
  "类": "重出",
  "宋本": 102,
  "覆盖": 1.0,
  "文本": "伤寒二三日，心中悸而烦者，小建中汤主之。方："
 },
 {
  "iid": "唐本-独-0112",
  "页": 331,
  "类": "重出",
  "宋本": 112,
  "覆盖": 0.946,
  "文本": "伤寒脉浮，而医以火迫劫之，亡阳，惊狂，卧起不安，桂枝去芍药加蜀漆牡蛎龙骨救逆汤主之。方："
 },
 {
  "iid": "唐本-独-0113",
  "页": 331,
  "类": "重出",
  "宋本": 117,
  "覆盖": 0.822,
  "文本": "烧针令其汗，针处被寒，核起而赤者，必发奔豚。气从少腹上冲者②，灸其核上一壮，与桂枝加桂汤。方："
 },
 {
  "iid": "唐本-独-0114",
  "页": 331,
  "类": "重出",
  "宋本": 118,
  "覆盖": 1.0,
  "文本": "火逆下之，因烧针烦躁者，桂枝甘草龙骨牡蛎汤主之。方："
 },
 {
  "iid": "唐本-独-0115",
  "页": 331,
  "类": "独立",
  "文本": "伤寒③，加温针，必惊。"
 },
 {
  "iid": "唐本-独-0116",
  "页": 332,
  "类": "重出",
  "宋本": 124,
  "覆盖": 0.919,
  "文本": "太阳病，六七日出①，表证续在，脉微而沉，反不结胸，其人发狂者，以热在下焦，少腹坚满，小便自利者，下血乃愈。所以然者，以太阳随经，瘀热②在里故也。宜下之，以抵当汤。"
 },
 {
  "iid": "唐本-独-0117",
  "页": 332,
  "类": "重出",
  "宋本": 125,
  "覆盖": 0.878,
  "文本": "太阳病，身黄，脉沉结，少腹坚，小便不利者，为无血；小便自利，其人如狂者，血证谛也。抵当汤主之。"
 },
 {
  "iid": "唐本-独-0118",
  "页": 332,
  "类": "重出",
  "宋本": 126,
  "覆盖": 1.0,
  "文本": "伤寒有热，少腹满，应小便不利，今反利者，为有血也，当须下之，不可余药，宜抵当丸。"
 },
 {
  "iid": "唐本-独-0119",
  "页": 332,
  "类": "碎片",
  "文本": "抵当汤方："
 },
 {
  "iid": "唐本-独-0120",
  "页": 332,
  "类": "碎片",
  "文本": "抵当丸方："
 },
 {
  "iid": "唐本-独-0121",
  "页": 332,
  "类": "重出",
  "宋本": 143,
  "覆盖": 0.942,
  "文本": "妇人中风，发热恶寒，经水适来，得七八日，热除而脉迟，身凉、胸胁下满，如结胸状，谵语④，此为热入血室，当刺期门，随其虚实而取之。"
 },
 {
  "iid": "唐本-独-0122",
  "页": 332,
  "类": "重出",
  "宋本": 144,
  "覆盖": 0.849,
  "文本": "妇人中风七八日，续得寒热，发作有时，经水适断者，此为热入血室，其血必结，故使如疟状，发作有时，小柴胡汤主之。方见柴胡汤门。"
 },
 {
  "iid": "唐本-独-0123",
  "页": 332,
  "类": "重出",
  "宋本": 145,
  "覆盖": 0.95,
  "文本": "妇人伤寒，发热，经水适来，昼日了了，暮则谵语，如见鬼状，此为热入血室，无犯胃气，及上二焦，必当自愈。"
 },
 {
  "iid": "唐本-独-0124",
  "页": 332,
  "类": "碎片",
  "文本": "--------------------------------------------------------------------------------"
 },
 {
  "iid": "唐本-独-0125",
  "页": 333,
  "类": "碎片",
  "文本": "又方："
 },
 {
  "iid": "唐本-独-0126",
  "页": 333,
  "类": "碎片",
  "文本": "黄芩汤方："
 },
 {
  "iid": "唐本-独-0127",
  "页": 333,
  "类": "独立",
  "文本": "黄芩加半夏生姜汤方："
 },
 {
  "iid": "唐本-独-0128",
  "页": 334,
  "类": "独立",
  "文本": "阳明病状第八 七十五证 方一十一首"
 },
 {
  "iid": "唐本-独-0129",
  "页": 334,
  "类": "独立",
  "文本": "阳明之为病，胃中寒是也。"
 },
 {
  "iid": "唐本-独-0130",
  "页": 336,
  "类": "重出",
  "宋本": 201,
  "覆盖": 0.909,
  "文本": "阳明病，脉浮而紧，其热必潮，发作有时，但浮者，必盗汗出。"
 },
 {
  "iid": "唐本-独-0131",
  "页": 336,
  "类": "独立",
  "文本": "夫病阳多者热，下之则坚，汗出多极，发其汗亦坚。"
 },
 {
  "iid": "唐本-独-0132",
  "页": 337,
  "类": "重出",
  "宋本": 238,
  "覆盖": 0.837,
  "文本": "阳明病，下之，心中懊憹而烦，胃中有燥屎者，可攻。其人腹微满，头坚后溏者，不可下之。有燥屎者，宜承气汤。"
 },
 {
  "iid": "唐本-独-0133",
  "页": 337,
  "类": "重出",
  "宋本": 239,
  "覆盖": 0.786,
  "文本": "病者五六日不大便，绕脐痛，躁烦，发作有时，此为有燥屎，故使不大便也。"
 },
 {
  "iid": "唐本-独-0134",
  "页": 338,
  "类": "独立",
  "文本": "病者烦热，汗出即解；复如疟状，日晡所发者，属阳明。脉实者，当下之；脉浮虚者，当发其汗。下之宜承气汤，发汗宜桂枝汤。方见桂枝汤门。"
 },
 {
  "iid": "唐本-独-0135",
  "页": 338,
  "类": "重出",
  "宋本": 241,
  "覆盖": 0.85,
  "文本": "大下后，六七日不大便，烦不解，腹满痛者，此有燥屎。所以然者，本有宿食故也①，宜承气汤。"
 },
 {
  "iid": "唐本-独-0136",
  "页": 338,
  "类": "独立",
  "文本": "病者小便不利，大便乍难乍易，时有微热，怫郁不能卧，有燥屎故也，宜承气汤。"
 },
 {
  "iid": "唐本-独-0137",
  "页": 338,
  "类": "重出",
  "宋本": 251,
  "覆盖": 0.828,
  "文本": "得病二三日，脉弱，无太阳柴胡证而烦，心下坚，至四日虽能食，以小承气汤少与，微和之，令小安。至六日，与承气汤一升。不大便六七日，小便少者，虽不大便，但头坚后溏，未定成其坚，攻之必溏。当须小便利，定坚，乃可攻之，宜承气汤。"
 },
 {
  "iid": "唐本-独-0138",
  "页": 338,
  "类": "重出",
  "宋本": 252,
  "覆盖": 0.889,
  "文本": "伤寒七八日，目中不了了，睛不和，无表里证，大便难，微热者，此为实，急下之，宜承气汤。"
 },
 {
  "iid": "唐本-独-0139",
  "页": 338,
  "类": "重出",
  "宋本": 255,
  "覆盖": 0.938,
  "文本": "腹满不减，减不足言，当下之，宜承气汤。"
 },
 {
  "iid": "唐本-独-0140",
  "页": 338,
  "类": "独立",
  "文本": "阳明与少阳合病而利，脉不负者为顺②，滑而数者有宿食，宜承气汤。方并见承气汤门。"
 },
 {
  "iid": "唐本-独-0141",
  "页": 338,
  "类": "重出",
  "宋本": 228,
  "覆盖": 0.892,
  "文本": "阳明病，下之，其外有热，手足温，不结胸，心中懊憹，若饥不能食，但头汗出，栀子汤主之。方："
 },
 {
  "iid": "唐本-独-0142",
  "页": 339,
  "类": "独立",
  "文本": "三阳合病，腹满身重，难以转侧，口不仁，言语向经，谵语遗尿。发汗则谵语；下之则额上生汗，手足厥冷，白虎汤主之。按：诸本皆云：“向经”，不敢刊改。"
 },
 {
  "iid": "唐本-独-0143",
  "页": 339,
  "类": "独立",
  "文本": "若脉浮迟，表热里寒，下利清谷，四逆汤主之。方："
 },
 {
  "iid": "唐本-独-0144",
  "页": 340,
  "类": "重出",
  "宋本": 234,
  "覆盖": 0.913,
  "文本": "阳明病，其脉迟，汗出多，而微恶寒，表为未解，可发汗，宜桂枝汤。"
 },
 {
  "iid": "唐本-独-0145",
  "页": 340,
  "类": "独立",
  "文本": "阳明病，脉浮，无汗，其人必喘，发汗即愈，宜麻黄汤。方并见上。"
 },
 {
  "iid": "唐本-独-0146",
  "页": 340,
  "类": "碎片",
  "文本": "又方："
 },
 {
  "iid": "唐本-独-0147",
  "页": 340,
  "类": "重出",
  "宋本": 260,
  "覆盖": 0.84,
  "文本": "伤寒七八日，身黄如橘，小便不利，其腹微满，茵陈汤主之。方："
 },
 {
  "iid": "唐本-独-0148",
  "页": 341,
  "类": "独立",
  "文本": "病者无表里证，发热七八日，虽脉浮数，可下之。假令下已，脉数不解，而合热消谷喜饥③，至六七日，不大便者，有瘀血，抵当汤主之。若数不解，而下不止，必挟热便脓血。方见杂疗中。"
 },
 {
  "iid": "唐本-独-0149",
  "页": 342,
  "类": "独立",
  "文本": "少阳病状第九 九证"
 },
 {
  "iid": "唐本-独-0150",
  "页": 343,
  "类": "碎片",
  "文本": "伤寒下"
 },
 {
  "iid": "唐本-独-0151",
  "页": 343,
  "类": "独立",
  "文本": "太阴病状第一 八证 方二首"
 },
 {
  "iid": "唐本-独-0152",
  "页": 343,
  "类": "独立",
  "文本": "太阴病，脉浮，可发其汗。"
 },
 {
  "iid": "唐本-独-0153",
  "页": 343,
  "类": "碎片",
  "文本": "加大黄汤方："
 },
 {
  "iid": "唐本-独-0154",
  "页": 343,
  "类": "独立",
  "文本": "上，于前方中加此大黄二两，即是。"
 },
 {
  "iid": "唐本-独-0155",
  "页": 344,
  "类": "独立",
  "文本": "少阴病状第二 四十五证 方一十六首"
 },
 {
  "iid": "唐本-独-0156",
  "页": 344,
  "类": "重出",
  "宋本": 292,
  "覆盖": 0.846,
  "文本": "少阴病，其人吐利，手足不逆，反发热，不死。脉不足者，灸其少阴七壮。"
 },
 {
  "iid": "唐本-独-0157",
  "页": 345,
  "类": "重出",
  "宋本": 296,
  "覆盖": 0.818,
  "文本": "少阴病，其人吐利，躁逆者死。"
 },
 {
  "iid": "唐本-独-0158",
  "页": 346,
  "类": "碎片",
  "文本": "甘草⑤"
 },
 {
  "iid": "唐本-独-0159",
  "页": 346,
  "类": "碎片",
  "文本": "桔梗汤方⑥："
 },
 {
  "iid": "唐本-独-0160",
  "页": 347,
  "类": "独立",
  "文本": "半夏洗  桂枝  甘草炙"
 },
 {
  "iid": "唐本-独-0161",
  "页": 349,
  "类": "独立",
  "文本": "厥阴病状第三 五十六证 方七首"
 },
 {
  "iid": "唐本-独-0162",
  "页": 349,
  "类": "重出",
  "宋本": 337,
  "覆盖": 0.909,
  "文本": "凡厥者，阴阳气不相顺接，便为厥。厥者，手足逆者是。"
 },
 {
  "iid": "唐本-独-0163",
  "页": 353,
  "类": "独立",
  "文本": "呕而发热，小柴胡汤主之。"
 },
 {
  "iid": "唐本-独-0164",
  "页": 353,
  "类": "独立",
  "文本": "伤寒宜忌第四 十五章"
 },
 {
  "iid": "唐本-独-0165",
  "页": 353,
  "类": "碎片",
  "文本": "忌发汗第一"
 },
 {
  "iid": "唐本-独-0166",
  "页": 353,
  "类": "重出",
  "宋本": 285,
  "覆盖": 0.8,
  "文本": "少阴病，脉细沉数，病在里，忌发其汗。"
 },
 {
  "iid": "唐本-独-0167",
  "页": 353,
  "类": "重出",
  "宋本": 50,
  "覆盖": 0.838,
  "文本": "脉浮而紧，法当身体疼痛，当以汗解。假令尺中脉迟者，忌发其汗。何以知然，此为荣气不足，血气微少故也。"
 },
 {
  "iid": "唐本-独-0168",
  "页": 353,
  "类": "独立",
  "文本": "少阴病，脉微，忌发其汗，无阳故也。"
 },
 {
  "iid": "唐本-独-0169",
  "页": 353,
  "类": "独立",
  "文本": "咽中闭塞，忌发其汗，发其汗即吐血，气微绝，逆冷②。"
 },
 {
  "iid": "唐本-独-0170",
  "页": 353,
  "类": "独立",
  "文本": "厥忌发其汗，发其汗即声乱、咽嘶、舌萎。"
 },
 {
  "iid": "唐本-独-0171",
  "页": 354,
  "类": "独立",
  "文本": "太阳病，发热恶寒，寒多热少，脉微弱，则无阳也，忌复发其汗。"
 },
 {
  "iid": "唐本-独-0172",
  "页": 354,
  "类": "重出",
  "宋本": 83,
  "覆盖": 0.778,
  "文本": "咽喉干燥者，忌发其汗。"
 },
 {
  "iid": "唐本-独-0173",
  "页": 354,
  "类": "独立",
  "文本": "亡血家，忌攻其表，汗出则寒栗而振。"
 },
 {
  "iid": "唐本-独-0174",
  "页": 354,
  "类": "独立",
  "文本": "衄家，忌攻其表，汗出必额上促急。"
 },
 {
  "iid": "唐本-独-0175",
  "页": 354,
  "类": "独立",
  "文本": "汗家，重发其汗，必恍惚心乱，小便已，阴疼。"
 },
 {
  "iid": "唐本-独-0176",
  "页": 354,
  "类": "重出",
  "宋本": 84,
  "覆盖": 0.818,
  "文本": "淋家，忌发其汗，发其汗，必便血。"
 },
 {
  "iid": "唐本-独-0177",
  "页": 354,
  "类": "独立",
  "文本": "疮家，虽身疼痛，忌攻其表，汗出则瘈。"
 },
 {
  "iid": "唐本-独-0178",
  "页": 354,
  "类": "独立",
  "文本": "冬时忌发其汗，发其汗必吐利，口中烂，生疮。咳而小便利，若失小便，忌攻其表，汗则厥，逆冷。"
 },
 {
  "iid": "唐本-独-0179",
  "页": 354,
  "类": "独立",
  "文本": "太阳病，发其汗，因致痉。"
 },
 {
  "iid": "唐本-独-0180",
  "页": 354,
  "类": "碎片",
  "文本": "宜发汗第二"
 },
 {
  "iid": "唐本-独-0181",
  "页": 354,
  "类": "独立",
  "文本": "大法，春夏宜发汗。"
 },
 {
  "iid": "唐本-独-0182",
  "页": 354,
  "类": "独立",
  "文本": "凡发汗，欲令手足皆周，漐漐一时间益佳，不欲流离。若病不解，当重发汗；汗多则亡阳，阳虚不得重发汗也。"
 },
 {
  "iid": "唐本-独-0183",
  "页": 354,
  "类": "独立",
  "文本": "凡服汤药发汗，中病便止，不必尽剂也。"
 },
 {
  "iid": "唐本-独-0184",
  "页": 354,
  "类": "独立",
  "文本": "凡云：宜发汗，而无汤者，丸散亦可用，然不如汤药也。"
 },
 {
  "iid": "唐本-独-0185",
  "页": 354,
  "类": "独立",
  "文本": "凡脉浮者，病在外，宜发其汗。"
 },
 {
  "iid": "唐本-独-0186",
  "页": 354,
  "类": "独立",
  "文本": "太阳病，脉浮而数者，宜发其汗。"
 },
 {
  "iid": "唐本-独-0187",
  "页": 354,
  "类": "独立",
  "文本": "阳明病，脉浮虚者，宜发其汗。"
 },
 {
  "iid": "唐本-独-0188",
  "页": 354,
  "类": "独立",
  "文本": "阳明病，其脉迟，汗出多，而微恶寒者，表为未解，宜发其汗。"
 },
 {
  "iid": "唐本-独-0189",
  "页": 354,
  "类": "独立",
  "文本": "太阳病，脉浮，宜发其汗。"
 },
 {
  "iid": "唐本-独-0190",
  "页": 354,
  "类": "重出",
  "宋本": 12,
  "覆盖": 0.93,
  "文本": "太阳中风，阳浮而阴濡弱，浮者，热自发，濡弱者，汗自出，啬啬恶寒，淅淅恶风，翕翕发热，鼻鸣干呕，桂枝汤主之。"
 },
 {
  "iid": "唐本-独-0191",
  "页": 354,
  "类": "独立",
  "文本": "太阳头痛发热，身体疼，腰痛，骨节疼痛，恶风，无汗而喘，麻黄汤主之。"
 },
 {
  "iid": "唐本-独-0192",
  "页": 354,
  "类": "独立",
  "文本": "太阳中风，脉浮紧，发热，恶寒，身体疼痛，不汗出而烦躁，大青龙汤主之。"
 },
 {
  "iid": "唐本-独-0193",
  "页": 355,
  "类": "独立",
  "文本": "少阴病，得之二三日，麻黄附子甘草汤微发汗。"
 },
 {
  "iid": "唐本-独-0194",
  "页": 355,
  "类": "碎片",
  "文本": "忌吐第三"
 },
 {
  "iid": "唐本-独-0195",
  "页": 355,
  "类": "独立",
  "文本": "太阳病，恶寒而发热，今自汗出，反不恶寒而发热，关上脉细而数。此吐之过也。"
 },
 {
  "iid": "唐本-独-0196",
  "页": 355,
  "类": "独立",
  "文本": "少阴病，其人饮食入则吐，心中温温欲吐，复不能吐。始得之，手足寒，脉弦运①，若膈上有寒饮，干呕，忌吐，当温之。"
 },
 {
  "iid": "唐本-独-0197",
  "页": 355,
  "类": "独立",
  "文本": "诸四逆病厥，忌吐，虚家亦然。"
 },
 {
  "iid": "唐本-独-0198",
  "页": 355,
  "类": "碎片",
  "文本": "宜吐第四"
 },
 {
  "iid": "唐本-独-0199",
  "页": 355,
  "类": "碎片",
  "文本": "大法，春宜吐。"
 },
 {
  "iid": "唐本-独-0200",
  "页": 355,
  "类": "独立",
  "文本": "凡服吐汤，中病便止，不必尽剂也。"
 },
 {
  "iid": "唐本-独-0201",
  "页": 355,
  "类": "独立",
  "文本": "病如桂枝证，其头项不强痛，寸口脉浮，胸中痞坚，上撞咽喉，不得息，此为有寒，宜吐之。"
 },
 {
  "iid": "唐本-独-0202",
  "页": 355,
  "类": "独立",
  "文本": "病胸上诸实，胸中郁郁而痛，不能食，欲使人按之，而反有涎唾，下利日十余行，其脉反迟，寸口微滑，此宜吐之，利即止。"
 },
 {
  "iid": "唐本-独-0203",
  "页": 355,
  "类": "独立",
  "文本": "少阴病，其人饮食入则吐，心中温温欲吐，复不能吐，宜吐之。"
 },
 {
  "iid": "唐本-独-0204",
  "页": 355,
  "类": "独立",
  "文本": "病者手足逆冷，脉乍紧，邪结在胸中，心下满而烦，饥不能食，病在胸中，宜吐之。"
 },
 {
  "iid": "唐本-独-0205",
  "页": 355,
  "类": "独立",
  "文本": "宿食在上管，宜吐之。"
 },
 {
  "iid": "唐本-独-0206",
  "页": 355,
  "类": "碎片",
  "文本": "忌下第五"
 },
 {
  "iid": "唐本-独-0207",
  "页": 355,
  "类": "独立",
  "文本": "咽中闭塞，忌下，下之则上轻下重，水浆不下。诸外实忌下，下之皆发微热，亡脉则厥。"
 },
 {
  "iid": "唐本-独-0208",
  "页": 355,
  "类": "独立",
  "文本": "诸虚忌下，下之则渴，引水易愈，恶水者剧。"
 },
 {
  "iid": "唐本-独-0209",
  "页": 355,
  "类": "独立",
  "文本": "脉数者忌下，下之必烦，利不止。"
 },
 {
  "iid": "唐本-独-0210",
  "页": 356,
  "类": "独立",
  "文本": "尺中弱涩者，复忌下。"
 },
 {
  "iid": "唐本-独-0211",
  "页": 356,
  "类": "独立",
  "文本": "脉浮大，医反下之，此为大逆。"
 },
 {
  "iid": "唐本-独-0212",
  "页": 356,
  "类": "独立",
  "文本": "太阳证不罢，忌下，下之为逆。"
 },
 {
  "iid": "唐本-独-0213",
  "页": 356,
  "类": "独立",
  "文本": "结胸证，其脉浮大，忌下，下之即死。"
 },
 {
  "iid": "唐本-独-0214",
  "页": 356,
  "类": "独立",
  "文本": "太阳与阳明合病，喘而胸满者，忌下。"
 },
 {
  "iid": "唐本-独-0215",
  "页": 356,
  "类": "独立",
  "文本": "太阳与少阳合病，心下痞坚，颈项强而眩，忌下。"
 },
 {
  "iid": "唐本-独-0216",
  "页": 356,
  "类": "独立",
  "文本": "凡四逆病厥者，忌下，虚家亦然。"
 },
 {
  "iid": "唐本-独-0217",
  "页": 356,
  "类": "独立",
  "文本": "病欲吐者，忌下。"
 },
 {
  "iid": "唐本-独-0218",
  "页": 356,
  "类": "独立",
  "文本": "病有外证未解，忌下，下之为逆。"
 },
 {
  "iid": "唐本-独-0219",
  "页": 356,
  "类": "独立",
  "文本": "少阴病，食入即吐，心中温温欲吐，复不能吐。始得之，手足寒，脉弦迟。此胸中实，忌下。"
 },
 {
  "iid": "唐本-独-0220",
  "页": 356,
  "类": "重出",
  "宋本": 347,
  "覆盖": 0.792,
  "文本": "伤寒五六日，不结胸，腹濡，脉虚复厥者，忌下，下之亡血则死。"
 },
 {
  "iid": "唐本-独-0221",
  "页": 356,
  "类": "碎片",
  "文本": "宜下第六"
 },
 {
  "iid": "唐本-独-0222",
  "页": 356,
  "类": "碎片",
  "文本": "大法，秋宜下。"
 },
 {
  "iid": "唐本-独-0223",
  "页": 356,
  "类": "独立",
  "文本": "凡宜下，以汤胜丸散。"
 },
 {
  "iid": "唐本-独-0224",
  "页": 356,
  "类": "独立",
  "文本": "凡服汤下，中病则止，不必尽齐①服。"
 },
 {
  "iid": "唐本-独-0225",
  "页": 356,
  "类": "独立",
  "文本": "阳明病，发热汗多者，急下之。"
 },
 {
  "iid": "唐本-独-0226",
  "页": 356,
  "类": "独立",
  "文本": "少阴病，得之二三日，口燥咽干者，急下之。"
 },
 {
  "iid": "唐本-独-0227",
  "页": 356,
  "类": "独立",
  "文本": "少阴病，五六日，腹满，不大便者，急下之。"
 },
 {
  "iid": "唐本-独-0228",
  "页": 356,
  "类": "独立",
  "文本": "少阴病，下利清水，色青者，心下必痛，口干者，宜下之。"
 },
 {
  "iid": "唐本-独-0229",
  "页": 356,
  "类": "独立",
  "文本": "下利，三部脉皆浮，按其心下坚者，宜下之。"
 },
 {
  "iid": "唐本-独-0230",
  "页": 356,
  "类": "独立",
  "文本": "下利，脉迟而滑者，实也，利未欲止，宜下之。"
 },
 {
  "iid": "唐本-独-0231",
  "页": 356,
  "类": "独立",
  "文本": "阳明与少阳合病，利而脉不负者为顺，脉数而滑者，有宿食，宜下之。"
 },
 {
  "iid": "唐本-独-0232",
  "页": 356,
  "类": "独立",
  "文本": "问曰：人病有宿食，何以别之？答曰：寸口脉浮大，按之反涩，尺"
 },
 {
  "iid": "唐本-独-0233",
  "页": 357,
  "类": "独立",
  "文本": "中亦微而涩，故知有宿食，宜下之。"
 },
 {
  "iid": "唐本-独-0234",
  "页": 357,
  "类": "独立",
  "文本": "下利，不欲食者，有宿食，宜下之。"
 },
 {
  "iid": "唐本-独-0235",
  "页": 357,
  "类": "独立",
  "文本": "下利差，至其时复发，此为病不尽，宜复下之。"
 },
 {
  "iid": "唐本-独-0236",
  "页": 357,
  "类": "独立",
  "文本": "凡病腹中满痛者为寒，宜下之。"
 },
 {
  "iid": "唐本-独-0237",
  "页": 357,
  "类": "独立",
  "文本": "腹满不减，减不足言，宜下之。"
 },
 {
  "iid": "唐本-独-0238",
  "页": 357,
  "类": "重出",
  "宋本": 252,
  "覆盖": 0.806,
  "文本": "伤寒六七日，目中不了了，睛不和，无表里证，大便难，微热者，此为实，急下之。"
 },
 {
  "iid": "唐本-独-0239",
  "页": 357,
  "类": "独立",
  "文本": "脉双弦而迟，心下坚，脉大而紧者，阳中有阴，宜下之①。"
 },
 {
  "iid": "唐本-独-0240",
  "页": 357,
  "类": "独立",
  "文本": "病者无表里证，发热七八日，虽脉浮数，宜下之②。"
 },
 {
  "iid": "唐本-独-0241",
  "页": 357,
  "类": "独立",
  "文本": "病者烦热，汗出即解，复如疟，日晡所发者属阳明，脉实者，当下之。"
 },
 {
  "iid": "唐本-独-0242",
  "页": 357,
  "类": "碎片",
  "文本": "宜温第七"
 },
 {
  "iid": "唐本-独-0243",
  "页": 357,
  "类": "独立",
  "文本": "大法，冬宜服温热药。"
 },
 {
  "iid": "唐本-独-0244",
  "页": 357,
  "类": "独立",
  "文本": "师曰：病发热头痛，脉反沉，若不差，身体更疼痛，当救其里，宜温药，四逆汤。"
 },
 {
  "iid": "唐本-独-0245",
  "页": 357,
  "类": "独立",
  "文本": "下利，腹胀满，身体疼痛，先温其里，宜四逆汤。"
 },
 {
  "iid": "唐本-独-0246",
  "页": 357,
  "类": "独立",
  "文本": "下利，脉迟紧，为痛，未欲止，宜温之③。"
 },
 {
  "iid": "唐本-独-0247",
  "页": 357,
  "类": "独立",
  "文本": "少阴病，下利，脉微涩，呕者，宜温之。"
 },
 {
  "iid": "唐本-独-0248",
  "页": 357,
  "类": "独立",
  "文本": "自利不渴者，属太阴，其藏有寒故也，宜温之。"
 },
 {
  "iid": "唐本-独-0249",
  "页": 357,
  "类": "独立",
  "文本": "少阴病，其人饮食入则吐，心中温温欲吐，复不能吐。始得之，手足寒，脉弦迟，若膈上有寒饮，干呕，宜温之。"
 },
 {
  "iid": "唐本-独-0250",
  "页": 358,
  "类": "独立",
  "文本": "少阴病，脉沉者，宜急温之。"
 },
 {
  "iid": "唐本-独-0251",
  "页": 358,
  "类": "独立",
  "文本": "下利，欲食者，宜就温之。①"
 },
 {
  "iid": "唐本-独-0252",
  "页": 358,
  "类": "碎片",
  "文本": "忌火第八"
 },
 {
  "iid": "唐本-独-0253",
  "页": 358,
  "类": "独立",
  "文本": "伤寒②，加火针，必惊。"
 },
 {
  "iid": "唐本-独-0254",
  "页": 358,
  "类": "独立",
  "文本": "伤寒脉浮，而医以火迫劫之，亡阳，必惊狂，卧起不安。"
 },
 {
  "iid": "唐本-独-0255",
  "页": 358,
  "类": "重出",
  "宋本": 114,
  "覆盖": 0.84,
  "文本": "太阳病，以火熏之，不得汗，其人必躁，到经不解，必清血。"
 },
 {
  "iid": "唐本-独-0256",
  "页": 358,
  "类": "重出",
  "宋本": 200,
  "覆盖": 0.947,
  "文本": "阳明病，被火，额上微汗出，而小便不利，必发黄。"
 },
 {
  "iid": "唐本-独-0257",
  "页": 358,
  "类": "重出",
  "宋本": 284,
  "覆盖": 0.926,
  "文本": "少阴病，咳而下利，谵语，是为被火气劫故也，小便必难，为强责少阴汗也。"
 },
 {
  "iid": "唐本-独-0258",
  "页": 358,
  "类": "碎片",
  "文本": "宜火第九"
 },
 {
  "iid": "唐本-独-0259",
  "页": 358,
  "类": "独立",
  "文本": "凡下利，谷道中痛，宜炙枳实，若熬盐等熨之。"
 },
 {
  "iid": "唐本-独-0260",
  "页": 358,
  "类": "碎片",
  "文本": "忌灸第十"
 },
 {
  "iid": "唐本-独-0261",
  "页": 358,
  "类": "独立",
  "文本": "微数之脉，慎不可灸，因火为邪，则为烦逆。"
 },
 {
  "iid": "唐本-独-0262",
  "页": 358,
  "类": "独立",
  "文本": "脉浮，当以汗解，而反灸之，邪无从去，因火而盛，病从腰以下，必重而痹，此为火逆。"
 },
 {
  "iid": "唐本-独-0263",
  "页": 358,
  "类": "重出",
  "宋本": 115,
  "覆盖": 0.917,
  "文本": "脉浮，热甚，而反灸之，此为实。实以虚治，因火而动，咽燥，必唾血。"
 },
 {
  "iid": "唐本-独-0264",
  "页": 358,
  "类": "碎片",
  "文本": "宜灸第十一"
 },
 {
  "iid": "唐本-独-0265",
  "页": 358,
  "类": "独立",
  "文本": "少阴病，一二日，口中和，其背恶寒，宜灸之。"
 },
 {
  "iid": "唐本-独-0266",
  "页": 358,
  "类": "独立",
  "文本": "少阴病，吐利，手足逆，而脉不足，灸其少阴七壮。"
 },
 {
  "iid": "唐本-独-0267",
  "页": 358,
  "类": "独立",
  "文本": "少阴病，下利，脉微涩者即哕，汗者必数更衣，反少者，宜温其"
 },
 {
  "iid": "唐本-独-0268",
  "页": 359,
  "类": "独立",
  "文本": "上，灸之。一云：灸厥阴五十壮。"
 },
 {
  "iid": "唐本-独-0269",
  "页": 359,
  "类": "独立",
  "文本": "下利，手足厥，无脉，灸之，主厥，厥阴是也。灸不温，反微喘者，死。"
 },
 {
  "iid": "唐本-独-0270",
  "页": 359,
  "类": "重出",
  "宋本": 343,
  "覆盖": 0.952,
  "文本": "伤寒六七日，其脉微，手足厥，烦躁，灸其厥阴，厥不还者，死。"
 },
 {
  "iid": "唐本-独-0271",
  "页": 359,
  "类": "独立",
  "文本": "脉促，手足厥者，宜灸之。"
 },
 {
  "iid": "唐本-独-0272",
  "页": 359,
  "类": "碎片",
  "文本": "忌刺第十二"
 },
 {
  "iid": "唐本-独-0273",
  "页": 359,
  "类": "独立",
  "文本": "大怒无刺 新内无刺 大劳无刺 大醉无刺 大饱无刺 大渴无刺 大惊无刺"
 },
 {
  "iid": "唐本-独-0274",
  "页": 359,
  "类": "独立",
  "文本": "无刺熇熇之热，无刺渌渌之汗，无刺浑浑之脉，无刺病与脉相逆者①。"
 },
 {
  "iid": "唐本-独-0275",
  "页": 359,
  "类": "独立",
  "文本": "上工刺未生，其次刺未盛，其次刺其衰。工逆此者，是谓伐形。"
 },
 {
  "iid": "唐本-独-0276",
  "页": 359,
  "类": "碎片",
  "文本": "宜刺第十三"
 },
 {
  "iid": "唐本-独-0277",
  "页": 359,
  "类": "重出",
  "宋本": 8,
  "覆盖": 0.806,
  "文本": "太阳病，头痛，至七日自当愈，其经竟故也。若欲作再经者，宜刺足阳明，使经不传则愈。"
 },
 {
  "iid": "唐本-独-0278",
  "页": 359,
  "类": "重出",
  "宋本": 24,
  "覆盖": 0.862,
  "文本": "太阳病，初服桂枝汤，而反烦不解，宜先刺风池、风府，乃却与桂枝汤则愈。"
 },
 {
  "iid": "唐本-独-0279",
  "页": 359,
  "类": "重出",
  "宋本": 108,
  "覆盖": 0.815,
  "文本": "伤寒，腹满而谵语，寸口脉浮而紧者，此为肝乘脾，名曰纵，宜刺期门。"
 },
 {
  "iid": "唐本-独-0280",
  "页": 359,
  "类": "重出",
  "宋本": 109,
  "覆盖": 0.857,
  "文本": "伤寒发热，啬啬恶寒，其人大渴，欲饮截浆者②，其腹必满，而自汗出，小便利，其病欲解，此为肝乘肺，名曰横，宜刺期门。"
 },
 {
  "iid": "唐本-独-0281",
  "页": 359,
  "类": "重出",
  "宋本": 216,
  "覆盖": 0.765,
  "文本": "阳明病，下血而谵语，此为热入血室，但头汗出者，刺期门，随其实而泻之。"
 },
 {
  "iid": "唐本-独-0282",
  "页": 359,
  "类": "重出",
  "宋本": 171,
  "覆盖": 0.815,
  "文本": "太阳与少阳合病，心下痞坚，颈项强而眩，宜刺大椎、肺俞、肝俞，勿下之。"
 },
 {
  "iid": "唐本-独-0283",
  "页": 360,
  "类": "独立",
  "文本": "妇人伤寒，怀身，腹满，不得小便，加从腰以下重，如有水气状。怀身七月，太阴当养不养，此心气实，宜刺，泻劳宫及关元，小便利，则愈①。"
 },
 {
  "iid": "唐本-独-0284",
  "页": 360,
  "类": "独立",
  "文本": "伤寒喉痹，刺手少阴穴，在腕当小指后动脉是也。针入三分，补之②。"
 },
 {
  "iid": "唐本-独-0285",
  "页": 360,
  "类": "重出",
  "宋本": 308,
  "覆盖": 0.909,
  "文本": "少阴病，下利便脓血者，宜刺。"
 },
 {
  "iid": "唐本-独-0286",
  "页": 360,
  "类": "碎片",
  "文本": "忌水第十四"
 },
 {
  "iid": "唐本-独-0287",
  "页": 360,
  "类": "独立",
  "文本": "发汗后，饮水多者必喘，以水灌之亦喘。"
 },
 {
  "iid": "唐本-独-0288",
  "页": 360,
  "类": "独立",
  "文本": "下利，其脉浮大，此为虚，以强下之故也。设脉浮革，因尔肠鸣，当温之，与水必哕③。"
 },
 {
  "iid": "唐本-独-0289",
  "页": 360,
  "类": "独立",
  "文本": "太阳病，小便利者，为水多，心下必悸。"
 },
 {
  "iid": "唐本-独-0290",
  "页": 360,
  "类": "碎片",
  "文本": "宣水第十五"
 },
 {
  "iid": "唐本-独-0291",
  "页": 360,
  "类": "独立",
  "文本": "太阳病，发汗后，若大汗出，胃中干，燥烦不得眠，其人欲饮水，当稍饮之，令胃气和则愈。"
 },
 {
  "iid": "唐本-独-0292",
  "页": 360,
  "类": "独立",
  "文本": "厥阴，渴欲饮水，与水饮之，即愈。"
 },
 {
  "iid": "唐本-独-0293",
  "页": 360,
  "类": "独立",
  "文本": "呕而吐，膈上者，必思煮饼，急思水者，与五苓散饮之，水亦得也④。"
 },
 {
  "iid": "唐本-独-0294",
  "页": 360,
  "类": "独立",
  "文本": "发汗吐下后病状第五 三十证 方一十五首"
 },
 {
  "iid": "唐本-独-0295",
  "页": 360,
  "类": "独立",
  "文本": "发汗后，水药不得入口，为逆。"
 },
 {
  "iid": "唐本-独-0296",
  "页": 360,
  "类": "独立",
  "文本": "未持脉时，病人手叉自冒心，师因教试令咳，而不即咳者，此必"
 },
 {
  "iid": "唐本-独-0297",
  "页": 361,
  "类": "独立",
  "文本": "两耳无所闻也。所以然者，重发其汗，虚故也。"
 },
 {
  "iid": "唐本-独-0298",
  "页": 361,
  "类": "独立",
  "文本": "发汗后身热，又重发其汗，胃中虚冷，必反吐也①。"
 },
 {
  "iid": "唐本-独-0299",
  "页": 361,
  "类": "独立",
  "文本": "大下后，发汗，其人小便不利②，此亡津液，勿治，其小便利，必自愈。"
 },
 {
  "iid": "唐本-独-0300",
  "页": 361,
  "类": "重出",
  "宋本": 122,
  "覆盖": 0.894,
  "文本": "病人脉数，数为热，当消谷引食，而反吐者，以医发其汗，阳气微，膈气虚，脉则为数。数为客热，不能消谷，胃中虚冷，故吐也。"
 },
 {
  "iid": "唐本-独-0301",
  "页": 361,
  "类": "独立",
  "文本": "病者有寒，复发其汗，胃中冷，必吐蛔。一云：吐逆。"
 },
 {
  "iid": "唐本-独-0302",
  "页": 361,
  "类": "独立",
  "文本": "发汗后，重发其汗，亡阳谵语，其脉反和者，不死③。服桂枝汤，汗出，大烦渴不解，若脉洪大，与白虎汤④。方见杂疗中。"
 },
 {
  "iid": "唐本-独-0303",
  "页": 361,
  "类": "独立",
  "文本": "发汗后，身体疼痛，其脉沉迟，桂枝加芍药生姜人参汤主之。方："
 },
 {
  "iid": "唐本-独-0304",
  "页": 361,
  "类": "重出",
  "宋本": 82,
  "覆盖": 0.903,
  "文本": "太阳病，发其汗而不解，其人发热，心下悸，头眩，身瞤而动，振振欲擗地者，玄武汤主之。方见少阴门。"
 },
 {
  "iid": "唐本-独-0305",
  "页": 361,
  "类": "独立",
  "文本": "发汗后，其人齐下悸，欲作奔豚，茯苓桂枝甘草大枣汤主之。方："
 },
 {
  "iid": "唐本-独-0306",
  "页": 361,
  "类": "重出",
  "宋本": 64,
  "覆盖": 0.96,
  "文本": "发汗过多以后，其人叉手自冒心，心下悸，而欲得按之，桂枝甘草汤主之。方："
 },
 {
  "iid": "唐本-独-0307",
  "页": 361,
  "类": "碎片",
  "文本": "————————————"
 },
 {
  "iid": "唐本-独-0308",
  "页": 362,
  "类": "独立",
  "文本": "发汗，脉浮而数，复烦者，五苓散主之。方见结胸门中。"
 },
 {
  "iid": "唐本-独-0309",
  "页": 362,
  "类": "重出",
  "宋本": 66,
  "覆盖": 0.95,
  "文本": "发汗后，腹胀满，厚朴生姜半夏甘草人参汤主之。方："
 },
 {
  "iid": "唐本-独-0310",
  "页": 362,
  "类": "重出",
  "宋本": 68,
  "覆盖": 0.808,
  "文本": "发其汗不解，而反恶寒者，虚故也，芍药甘草附子汤主之。方："
 },
 {
  "iid": "唐本-独-0311",
  "页": 362,
  "类": "独立",
  "文本": "不恶寒，但热者②，实也，当和其胃气，宜小承气汤。方见承气汤"
 },
 {
  "iid": "唐本-独-0312",
  "页": 362,
  "类": "独立",
  "文本": "门。一云：调胃承气汤。"
 },
 {
  "iid": "唐本-独-0313",
  "页": 362,
  "类": "独立",
  "文本": "伤寒，脉浮，自汗出，小便数，颇复③微恶寒，而脚挛急。反与桂"
 },
 {
  "iid": "唐本-独-0314",
  "页": 362,
  "类": "独立",
  "文本": "枝④，欲攻其表，得之便厥，咽干，烦躁，吐逆，当作甘草干姜汤，以"
 },
 {
  "iid": "唐本-独-0315",
  "页": 362,
  "类": "独立",
  "文本": "复其阳。厥愈足温，更作芍药甘草汤与之，其脚即伸。而胃气不和，"
 },
 {
  "iid": "唐本-独-0316",
  "页": 362,
  "类": "独立",
  "文本": "可与承气汤；重发汗，复加烧针者，四逆汤主之。"
 },
 {
  "iid": "唐本-独-0317",
  "页": 362,
  "类": "独立",
  "文本": "甘草干姜汤方："
 },
 {
  "iid": "唐本-独-0318",
  "页": 362,
  "类": "独立",
  "文本": "芍药甘草汤方："
 },
 {
  "iid": "唐本-独-0319",
  "页": 362,
  "类": "重出",
  "宋本": 58,
  "覆盖": 0.87,
  "文本": "凡病，若发汗、若吐、若下、若亡血，无津液，而阴阳自和者，必"
 },
 {
  "iid": "唐本-独-0320",
  "页": 362,
  "类": "碎片",
  "文本": "自愈。"
 },
 {
  "iid": "唐本-独-0321",
  "页": 362,
  "类": "独立",
  "文本": "伤寒，吐下、发汗后，心下逆满，气上撞胸，起即头眩，其脉沉"
 },
 {
  "iid": "唐本-独-0322",
  "页": 362,
  "类": "独立",
  "文本": "紧，发汗即动经，身为振摇，茯苓桂枝白术甘草汤主之。方："
 },
 {
  "iid": "唐本-独-0323",
  "页": 363,
  "类": "独立",
  "文本": "发汗、吐下以后不解，烦躁，茯苓四逆汤主之。方："
 },
 {
  "iid": "唐本-独-0324",
  "页": 363,
  "类": "独立",
  "文本": "发汗、吐下后，虚烦不得眠，剧者，反复颠倒，心中懊侬，栀子汤主之。若少气，栀子甘草汤主之。若呕者，栀子生姜汤主之。栀子汤方见阳明门。"
 },
 {
  "iid": "唐本-独-0325",
  "页": 363,
  "类": "独立",
  "文本": "栀子甘草汤方："
 },
 {
  "iid": "唐本-独-0326",
  "页": 363,
  "类": "独立",
  "文本": "于栀子汤中，加甘草二两即是。"
 },
 {
  "iid": "唐本-独-0327",
  "页": 363,
  "类": "独立",
  "文本": "栀子生姜汤方："
 },
 {
  "iid": "唐本-独-0328",
  "页": 363,
  "类": "独立",
  "文本": "于栀子汤中，加生姜五两即是。"
 },
 {
  "iid": "唐本-独-0329",
  "页": 363,
  "类": "重出",
  "宋本": 79,
  "覆盖": 0.9,
  "文本": "伤寒下后，烦而腹满，卧起不安，栀子厚朴汤主之。方："
 },
 {
  "iid": "唐本-独-0330",
  "页": 363,
  "类": "重出",
  "宋本": 60,
  "覆盖": 0.87,
  "文本": "下以后，发其汗，必振寒，又其脉微细。所以然者，内外俱虚故也。"
 },
 {
  "iid": "唐本-独-0331",
  "页": 363,
  "类": "独立",
  "文本": "发汗，若下之，烦热，胸中窒者，属栀子汤证。"
 },
 {
  "iid": "唐本-独-0332",
  "页": 363,
  "类": "重出",
  "宋本": 61,
  "覆盖": 0.821,
  "文本": "下以后，复发其汗者，则昼日烦躁不眠，夜而安静，不呕不渴，而无表证，其脉沉微，身无大热，属附子干姜汤。方："
 },
 {
  "iid": "唐本-独-0333",
  "页": 363,
  "类": "重出",
  "宋本": 93,
  "覆盖": 0.83,
  "文本": "太阳病，先下而不愈，因复发其汗，表里俱虚，其人因冒，冒家当汗出自愈。所以然者，汗出表和故也，表和故下之①。"
 },
 {
  "iid": "唐本-独-0334",
  "页": 364,
  "类": "重出",
  "宋本": 80,
  "覆盖": 0.913,
  "文本": "伤寒，医以丸药大下后，身热不去，微烦，栀子干姜汤主之。方："
 },
 {
  "iid": "唐本-独-0335",
  "页": 364,
  "类": "重出",
  "宋本": 49,
  "覆盖": 0.923,
  "文本": "脉浮数，法当汗出而愈，而下之，则身体重，心悸者，不可发其汗，当自汗出而解。所以然者，尺中脉微，此里虚，须表里实，津液自和，自汗出，愈。"
 },
 {
  "iid": "唐本-独-0336",
  "页": 364,
  "类": "重出",
  "宋本": 63,
  "覆盖": 0.793,
  "文本": "发汗以后，不可行桂枝汤，汗出而喘，无大热，与麻黄杏子石膏甘草汤。方："
 },
 {
  "iid": "唐本-独-0337",
  "页": 364,
  "类": "重出",
  "宋本": 168,
  "覆盖": 0.87,
  "文本": "伤寒吐下后，七八日不解，热结在里，表里俱热，时时恶风②，大渴，舌上干燥而烦，欲饮水数升，白虎汤主之。方见杂疗中。"
 },
 {
  "iid": "唐本-独-0338",
  "页": 364,
  "类": "独立",
  "文本": "伤寒，吐下后未解，不大便五六日，至十余日，其人日晡所发潮热，不恶寒，犹如见鬼神之状，剧者发则不识人，循衣妄撮，怵惕不安，微喘直视，脉弦者生，涩者死。微者但发热谵语，与承气汤，若下者，勿复服。"
 },
 {
  "iid": "唐本-独-0339",
  "页": 364,
  "类": "独立",
  "文本": "大下后，口燥者，里虚故也。③"
 },
 {
  "iid": "唐本-独-0340",
  "页": 364,
  "类": "独立",
  "文本": "霍乱病状第六 一十证 方三首"
 },
 {
  "iid": "唐本-独-0341",
  "页": 364,
  "类": "重出",
  "宋本": 382,
  "覆盖": 0.944,
  "文本": "问曰：病有霍乱者，何也？答曰：呕吐而利，此为霍乱。"
 },
 {
  "iid": "唐本-独-0342",
  "页": 364,
  "类": "重出",
  "宋本": 383,
  "覆盖": 0.838,
  "文本": "问曰：病者发热头痛，身体疼痛，恶寒而复吐利，当属何病？答曰：当为霍乱。霍乱吐下利止，复更发热也。"
 },
 {
  "iid": "唐本-独-0343",
  "页": 365,
  "类": "独立",
  "文本": "四逆汤中加人参一两，即是。"
 },
 {
  "iid": "唐本-独-0344",
  "页": 365,
  "类": "独立",
  "文本": "于通脉四逆汤中，加猪胆汁半合即是。服之，其脉即出，无猪"
 },
 {
  "iid": "唐本-独-0345",
  "页": 366,
  "类": "独立",
  "文本": "胆，以羊胆代之。"
 },
 {
  "iid": "唐本-独-0346",
  "页": 366,
  "类": "独立",
  "文本": "阴易病已后劳复第七  七证  一方四首①  附方六首"
 },
 {
  "iid": "唐本-独-0347",
  "页": 366,
  "类": "独立",
  "文本": "妇人里褌近隐处烧灰"
 },
 {
  "iid": "唐本-独-0348",
  "页": 367,
  "类": "重出",
  "宋本": 396,
  "覆盖": 0.792,
  "文本": "大病已后，其人喜唾，久久不了，胸上有寒，当温之，宜理中丸。"
 },
 {
  "iid": "唐本-独-0349",
  "页": 367,
  "类": "独立",
  "文本": "杂方附（校注者注：因非《伤寒论》方，故略）"
 },
 {
  "iid": "唐本-独-0350",
  "页": 0,
  "类": "前置",
  "文本": "底本:《伤寒论版本大全》(李顺保 编著)·学苑出版社 源文件:伤寒论版本大全 (李顺保编著).pdf(901 页扫描件) PDF 页码:第 309–368 页 原书印刷页码:第 299–358 页 转录方式:扫描件逐页视觉转录(未作校订,异"
 },
 {
  "iid": "唐本-独-0351",
  "页": 309,
  "类": "前置",
  "文本": "[汉] 张仲景 撰[唐] 孙思邈 辑海陵 李顺保 校注学苑出版社"
 },
 {
  "iid": "唐本-独-0352",
  "页": 313,
  "类": "独立",
  "文本": "太阳病，发热汗出，而不恶寒，是为柔痉。一云：恶寒④。"
 },
 {
  "iid": "唐本-独-0353",
  "页": 313,
  "类": "独立",
  "文本": "太阳病，发热，其脉沉细，是为痉。"
 },
 {
  "iid": "唐本-独-0354",
  "页": 314,
  "类": "独立",
  "文本": "太阳病，而关节疼痛，其脉沉缓，为中湿。"
 },
 {
  "iid": "唐本-独-0355",
  "页": 317,
  "类": "独立",
  "文本": "伤寒，大下后，复发汗④，心下痞，恶寒者，不可攻痞，当先解表，宜桂枝汤。桂枝汤方桂枝 芍药 生姜各二两，切 甘草二两，炙 大枣十二枚，擘上五味，㕮咀三味⑤，以水七升，微火煮取三升，去滓。温服一升，须臾，饮热粥一升余，以助药力。温覆，令汗出一时"
 },
 {
  "iid": "唐本-独-0356",
  "页": 318,
  "类": "独立",
  "文本": "者，此为阴阳俱虚，不可复吐下、发汗也。面色反有热者，为未欲解，以其不能得汗出，身必当痒，桂枝麻黄各半汤主之。桂枝一两十六铢① 芍药 生姜切 甘草炙 麻黄去节，各一两 大枣四枚，擘 杏仁二十四枚，去皮尖、两仁者上七味，以水五升，先煮麻黄一二沸"
 },
 {
  "iid": "唐本-独-0357",
  "页": 318,
  "类": "独立",
  "文本": "上于桂枝汤中，惟除去桂枝一味，加此二味为汤，服一升，小便即利。本云：桂枝汤，今去桂枝，加茯苓、白术。"
 },
 {
  "iid": "唐本-独-0358",
  "页": 319,
  "类": "独立",
  "文本": "脉浮而紧，浮则为风，紧则为寒，风则伤卫，寒则伤荣，荣卫俱病，骨节烦疼，可发其汗，宜麻黄汤。"
 },
 {
  "iid": "唐本-独-0359",
  "页": 319,
  "类": "独立",
  "文本": "太阳病，下之微喘者，外未解故也，宜麻黄汤。一云：桂枝汤。麻黄汤方：麻黄去节，三两 桂枝二两 甘草一两，炙 杏仁七十枚，去皮尖，两仁者上四味，以水九升煮麻黄，减二升，去上沫，内诸药，煮取二升"
 },
 {
  "iid": "唐本-独-0360",
  "页": 323,
  "类": "独立",
  "文本": "柴胡加大黄芒消桑螵蛸汤方①：上以前七味，以水七升，下芒消三合，大黄四分，桑螵蛸五枚，煮取一升半，去滓，温服五合，微下即愈。本云：柴胡汤，再服以解其外，余二升，加芒消、大黄、桑螵蛸也。"
 },
 {
  "iid": "唐本-独-0361",
  "页": 323,
  "类": "独立",
  "文本": "发汗多，亡阳狂语者，不可下，以为可与柴胡桂枝汤，和其荣卫，以通津液后，自愈。方：柴胡四两 黄芩 人参 生姜切 桂枝 芍药各一两半 半夏二合半，洗 甘草一两，炙 大枣六枚，擘上九味，以水六升，煮取二升，去滓，温服一升。本云：人参汤，作如桂枝法"
 },
 {
  "iid": "唐本-独-0362",
  "页": 325,
  "类": "独立",
  "文本": "又方：大黄四两 厚朴二两，炙 枳实大者三枚，炙上三味，以水四升，煮取一升二合，去滓，温分再服。初服谵语即止，服汤当更衣，不尔，尽服之。"
 },
 {
  "iid": "唐本-独-0363",
  "页": 325,
  "类": "独立",
  "文本": "又方：大黄四两 甘草二两，炙 芒消半两上三味，以水三升，煮取一升，去滓，内芒消，更一沸，顿服。"
 },
 {
  "iid": "唐本-独-0364",
  "页": 325,
  "类": "独立",
  "文本": "两上五味，以水七升，煮取二升半，去滓，内芒消，更煎一沸，分温三服。"
 },
 {
  "iid": "唐本-独-0365",
  "页": 333,
  "类": "独立",
  "文本": "又方：知母六两 石膏一斤，碎 甘草二两，炙 人参三两 粳米六合上五味，以水一斗，煮米熟，汤成，去滓，温服一升，日三服。立夏后至立秋前得用之，立秋后，不可服。春三月，病常苦里冷①，白虎汤亦不可与之，与之即呕利而腹痛。诸亡血及虚家，亦不可与白虎"
 },
 {
  "iid": "唐本-独-0366",
  "页": 334,
  "类": "独立",
  "文本": "术附子汤方：于前方中去桂，加白术四两即是。一服觉身痹，半日许复服之尽，其人如冒状，勿怪，即是附子、术并走皮中，逐水气未得除，故使之耳，法当加桂四两。以大便坚，小便自利，故不加桂也。"
 },
 {
  "iid": "唐本-独-0367",
  "页": 337,
  "类": "独立",
  "文本": "阳明病，潮热，微坚，可与承气汤，不坚，勿与之。"
 },
 {
  "iid": "唐本-独-0368",
  "页": 340,
  "类": "独立",
  "文本": "大猪胆一枚，泻汁，和少法醋，以灌谷道中，如一食顷，当大便，出宿食恶物。已试，甚良。"
 },
 {
  "iid": "唐本-独-0369",
  "页": 350,
  "类": "独立",
  "文本": "乌梅三百枚 细辛六两 干姜十两 黄连十六两 当归四两 蜀椒四两，汗 附子六两，炮 桂枝六两 人参六两 黄柏六两上一十味，异捣，合治之。以苦酒渍乌梅一宿，去核，蒸之五斗米下，捣成泥，和诸药，令相得。臼中与蜜杵千下，丸如梧桐子大。先食饮服十九。"
 },
 {
  "iid": "唐本-独-0370",
  "页": 353,
  "类": "独立",
  "文本": "忌发汗第一少阴病，脉细沉数，病在里，忌发其汗。"
 },
 {
  "iid": "唐本-独-0371",
  "页": 354,
  "类": "独立",
  "文本": "宜发汗第二大法，春夏宜发汗。"
 },
 {
  "iid": "唐本-独-0372",
  "页": 355,
  "类": "独立",
  "文本": "宜吐第四大法，春宜吐。"
 },
 {
  "iid": "唐本-独-0373",
  "页": 355,
  "类": "独立",
  "文本": "忌下第五咽中闭塞，忌下，下之则上轻下重，水浆不下。诸外实忌下，下之皆发微热，亡脉则厥。"
 },
 {
  "iid": "唐本-独-0374",
  "页": 356,
  "类": "独立",
  "文本": "宜下第六大法，秋宜下。"
 },
 {
  "iid": "唐本-独-0375",
  "页": 356,
  "类": "独立",
  "文本": "问曰：人病有宿食，何以别之？答曰：寸口脉浮大，按之反涩，尺中亦微而涩，故知有宿食，宜下之。"
 },
 {
  "iid": "唐本-独-0376",
  "页": 357,
  "类": "独立",
  "文本": "伤寒有热，而少腹满，应小便不利，今反利，此为血，宜下之。"
 },
 {
  "iid": "唐本-独-0377",
  "页": 357,
  "类": "独立",
  "文本": "宜温第七大法，冬宜服温热药。"
 },
 {
  "iid": "唐本-独-0378",
  "页": 357,
  "类": "独立",
  "文本": "下利，脉浮大者，此为虚，以强下之故也。宜温之，与水必哕④。"
 },
 {
  "iid": "唐本-独-0379",
  "页": 358,
  "类": "独立",
  "文本": "下利，欲食者，宜就温之。①忌火第八伤寒②，加火针，必惊。"
 },
 {
  "iid": "唐本-独-0380",
  "页": 358,
  "类": "独立",
  "文本": "宜火第九凡下利，谷道中痛，宜炙枳实，若熬盐等熨之。"
 },
 {
  "iid": "唐本-独-0381",
  "页": 358,
  "类": "独立",
  "文本": "宜灸第十一少阴病，一二日，口中和，其背恶寒，宜灸之。"
 },
 {
  "iid": "唐本-独-0382",
  "页": 358,
  "类": "重出",
  "宋本": 325,
  "覆盖": 0.794,
  "文本": "少阴病，下利，脉微涩者即哕，汗者必数更衣，反少者，宜温其上，灸之。一云：灸厥阴五十壮。"
 },
 {
  "iid": "唐本-独-0383",
  "页": 359,
  "类": "独立",
  "文本": "忌刺第十二大怒无刺 新内无刺 大劳无刺 大醉无刺 大饱无刺 大渴无刺 大惊无刺无刺熇熇之热，无刺渌渌之汗，无刺浑浑之脉，无刺病与脉相逆者①。"
 },
 {
  "iid": "唐本-独-0384",
  "页": 359,
  "类": "重出",
  "宋本": 8,
  "覆盖": 0.806,
  "文本": "宜刺第十三太阳病，头痛，至七日自当愈，其经竟故也。若欲作再经者，宜刺足阳明，使经不传则愈。"
 },
 {
  "iid": "唐本-独-0385",
  "页": 361,
  "类": "独立",
  "文本": "上二味，以水三升，煮取一升，去滓，顿服，即愈。"
 },
 {
  "iid": "唐本-独-0386",
  "页": 365,
  "类": "独立",
  "文本": "于通脉四逆汤中，加猪胆汁半合即是。服之，其脉即出，无猪胆，以羊胆代之。"
 },
 {
  "iid": "唐本-独-0387",
  "页": 367,
  "类": "碎片",
  "文本": "升，日三服。"
 }
]