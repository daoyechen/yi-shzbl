 },
 {
  "iid": "唐本-独-0007",
  "页": 310,
  "类": "前置",
  "文本": "《唐本伤寒论》是指孙思邈编进《千金翼方》中的卷九和卷十的《伤寒论》。"
 },
 {
  "iid": "唐本-独-0008",
  "页": 310,
  "类": "前置",
  "文本": "此次点校的底本系清光绪四年（1878年）按日本文政十二年（1829年）重雕元大德刊本，即元大德十一年丁未（1307年）良月梅溪书院刻样本。"
 },
 {
  "iid": "唐本-独-0009",
  "页": 310,
  "类": "前置",
  "文本": "所用校本系清乾隆二十八年癸未（1763年）华希闵翻刻明万历三十三年乙巳（1605年）王肯堂与其侄王廷鉴校定刊刻本，因由保元堂镌刻，后称保元堂本。"
 },
 {
  "iid": "唐本-独-0010",
  "页": 310,
  "类": "前置",
  "文本": "其他校本则采用本书《版本大全》中的各版本。"
 },
 {
  "iid": "唐本-独-0011",
  "页": 310,
  "类": "前置",
  "文本": "凡高保衡、孙奇和林亿等人校正《千金翼方》的按语，则用六号宋体字排出，以区别正文。"
 },
