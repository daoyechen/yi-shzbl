 },
 {
  "iid": "康平本-独-0173",
  "页": 69,
  "类": "独立",
  "文本": "康平伤寒论目录终"
 },
 {
  "iid": "康平本-独-0174",
  "页": 71,
  "类": "碎片",
  "文本": "伤寒卒病论"
 },
 {
  "iid": "康平本-独-0175",
  "页": 71,
  "类": "独立",
  "文本": "余每览越人入虢之诊，望齐侯之色，未尝不慨然叹其才秀也。"
 },
 {
  "iid": "康平本-独-0176",
  "页": 71,
  "类": "碎片",
  "文本": "集论曰"
 },
 {
  "iid": "康平本-独-0177",
  "页": 71,
  "类": "独立",
  "文本": "怪当今居世之士，曾不留神医药，精究方术，上以疗君亲之病①，下以救贫贱之厄，中以保身长全，以养其生，但竞逐荣势，企踵权豪，孜孜汲汲，惟名利是务，崇饰其末，忽弃其本，华其外而悴其内，皮之不存，毛将安附焉。哀乎！趋世之士，又驰竞浮华，不固根本②。"
 },
 {
  "iid": "康平本-独-0178",
  "页": 71,
  "类": "独立",
  "文本": "夫天布五行，以运万类，人禀五常，以有五藏，经络府俞，阴阳会通，玄冥幽微，变化难极，自非才高识妙，岂能探其理致哉！ 上古有神农、黄帝、岐伯、伯高、雷公、少俞、"
 },
 {
  "iid": "康平本-独-0179",
  "页": 72,
  "类": "独立",
  "文本": "少师、仲文，中世有长桑、扁鹊，汉有公乘阳庆及仓公，下"
 },
 {
  "iid": "康平本-独-0180",
  "页": 72,
  "类": "独立",
  "文本": "此以往，未之闻也。观今之医，不念思求经旨，以演其所"
 },
 {
  "iid": "康平本-独-0181",
  "页": 72,
  "类": "独立",
  "文本": "知，各承家技，终始顺旧，省疾问病，务有①口给，相对斯"
 },
 {
  "iid": "康平本-独-0182",
  "页": 72,
  "类": "独立",
  "文本": "须，便处汤药，按寸不及尺，握手不及足，人迎、趺阳，三"
 },
 {
  "iid": "康平本-独-0183",
  "页": 72,
  "类": "独立",
  "文本": "部不参，动数发息，不满五十，短期未知决诊，九候曾无仿"
 },
 {
  "iid": "康平本-独-0184",
  "页": 72,
  "类": "独立",
  "文本": "佛，明堂阙庭，尽不见察，所谓窥管而已。夫欲视死别生，"
 },
 {
  "iid": "康平本-独-0185",
  "页": 72,
  "类": "独立",
  "文本": "实为难矣。孔子云：生而知之者上，学则亚之，多闻博识，"
 },
 {
  "iid": "康平本-独-0186",
  "页": 72,
  "类": "独立",
  "文本": "知之次也。余宿尚方术，请事斯语②。"
 },
 {
  "iid": "康平本-独-0187",
  "页": 72,
  "类": "碎片",
  "文本": "————————"
 },
 {
  "iid": "康平本-独-0188",
  "页": 73,
  "类": "独立",
  "文本": "汉长沙守南阳张机著"
 },
 {
  "iid": "康平本-独-0189",
  "页": 73,
  "类": "独立",
  "文本": "晋大医令王叔和撰次"
 },
 {
  "iid": "康平本-独-0190",
  "页": 73,
  "类": "碎片",
  "文本": "伤寒例"
 },
 {
  "iid": "康平本-独-0191",
  "页": 73,
  "类": "独立",
  "文本": "凡春气温和，夏气暑热，秋气漓冷，冬[气]冰冽，此则四时正气之序也。《阴阳大论》云㊟冬时严寒，万类深藏，君子固密，则不伤寒。触冒之者，乃名伤寒耳。[例]其于伤四时之气，皆能为病。中[寒]而即病者，名曰伤寒。以伤寒为毒者，以其最成杀厉之气也。"
 },
 {
  "iid": "康平本-独-0192",
  "页": 73,
  "类": "独立",
  "文本": "中寒，不即病者，寒毒藏于肌肤，至春变为温病，至夏变为暑病。暑病者，热极重于温也。㊟是以辛苦之人，春夏多温热病者，皆由冬时触寒所致，非时行之气也。"
 },
 {
  "iid": "康平本-独-0193",
  "页": 73,
  "类": "独立",
  "文本": "凡时行者，春时应暖而反大寒，夏时应热而反大凉，秋时应凉而反大热，冬时应寒而反大温㊟是以一岁之中，长幼之病，多相似者也。[凡]此非其时，而有其气。此则时行之气也。"
 },
 {
  "iid": "康平本-独-0194",
  "页": 74,
  "类": "独立",
  "文本": "三月、四月，或有暴寒，其时阳气尚弱，为寒所折，病热犹轻。"
 },
 {
  "iid": "康平本-独-0195",
  "页": 74,
  "类": "独立",
  "文本": "五月、六月，阳气已盛，为寒所折，病热则重。七月、八月，阳气已衰，为寒所折，病热亦轻①。"
 },
 {
  "iid": "康平本-独-0196",
  "页": 74,
  "类": "独立",
  "文本": "病与温及暑病相似，但治有殊耳。十五日得一气，于四时之中，一时有六气，四六名为二十四气。然气候亦有应至而不至，或有未应至而至者，或有至而太过②者，皆成病气也。"
 },
 {
  "iid": "康平本-独-0197",
  "页": 74,
  "类": "独立",
  "文本": "但天地动静，阴阳鼓击者，各正一气耳。"
 },
 {
  "iid": "康平本-独-0198",
  "页": 74,
  "类": "独立",
  "文本": "是以彼春之暖，为夏之暑。彼之秋之忿，为冬之怒。是故冬至后，一阳爻升，一阴爻降也。夏至之后，一阳气下，一阴气上也。斯则冬夏二至，阴阳合也；春秋二分，阴阳离也。阴阳交易，人变病焉。此君子春夏养阳，秋冬养阴，顺天地之刚柔也。小人触冒，必婴暴疹。须"
 },
 {
  "iid": "康平本-独-0199",
  "页": 74,
  "类": "独立",
  "文本": "伤寒之病，逐日浅深，以施方治。今世人伤寒，或始不早治，或治不对病，或日数久淹，困乃告医。医人又不依次第而治之，则不中病。皆宜临时消息制方，无不效也。今搜采仲景旧论，录其证候、诊脉、声色，对病[真]方，有神验者，拟防世急也。"
 },
 {
  "iid": "康平本-独-0200",
  "页": 74,
  "类": "碎片",
  "文本": "----------------------------------------"
 },
 {
  "iid": "康平本-独-0201",
  "页": 75,
  "类": "独立",
  "文本": "凡①土地温凉，高下不同，物性刚柔，餐居亦异。是故黄帝兴四方之问，岐伯举四治之能，以训后贤，开其未悟者。临病之工，宜须两审也。"
 },
 {
  "iid": "康平本-独-0202",
  "页": 75,
  "类": "独立",
  "文本": "凡伤于寒，则为病热，热虽甚，不死。若两感寒而病者，必死。若更感异气，变为他病者，当依后坏病证而治之②。"
 },
 {
  "iid": "康平本-独-0203",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱浮者，大阳③受病也，当一二日发。以其脉上连风府，故头项痛，腰背强。"
 },
 {
  "iid": "康平本-独-0204",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱长者，阳明受病也，当二三日发。以其脉夹鼻、络于目，故身热、目疼、鼻干、不得卧。"
 },
 {
  "iid": "康平本-独-0205",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱弦者，少阳受病也，当三四日发。以其脉循胁络于耳，故胸胁痛而耳聋。此三经皆受病，未入于府者，可汗而已。"
 },
 {
  "iid": "康平本-独-0206",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱沉细者，大阴④受病也，当四五日发。以其脉布胃中，络于嗌，故腹满而嗌干。"
 },
 {
  "iid": "康平本-独-0207",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱沉者，少阴受病也，当五六日发。以其脉贯肾，络于肺，系舌本，故口燥、舌干而渴。"
 },
 {
  "iid": "康平本-独-0208",
  "页": 75,
  "类": "独立",
  "文本": "尺寸俱微缓者，厥阴受病也，当六七日发。以其脉循阴器，络于肝，故烦满而囊缩。此三经皆受病，已入于府，可下而已。"
 },
 {
  "iid": "康平本-独-0209",
  "页": 75,
  "类": "独立",
  "文本": "若两感于寒者，一日大阳受之，即与少阴俱病，则头痛、口干、烦满而渴；二日阳明受之，即与大阴俱病，则腹满身热、不欲食、谵语；三日少阳受之，即与厥阴俱病，则耳聋、囊缩而厥、水浆不入、不知人者，六日死。若三阴三阳、五脏六腑皆受病，则荣卫不行，藏府不"
 },
 {
  "iid": "康平本-独-0210",
  "页": 76,
  "类": "独立",
  "文本": "两感于寒，更不传经，不加异气者，至七日太阳病衰，头痛少愈也；八日阳明病衰，身热少歇也；九日少阳病衰，耳聋微闻也；十日大阴病衰，腹减如故，则思饮食；十一日少阴病衰，渴止、舌干已而嚏也；十二日厥阴病衰，囊纵、少腹微下，大气皆去，病人精神爽慧也。"
 },
 {
  "iid": "康平本-独-0211",
  "页": 76,
  "类": "独立",
  "文本": "凡人有疾，不时即治，隐忍冀差，以成痼疾。小儿女子，益以兹甚，时气不和，便当早言，寻其邪由，及在腠理，以时治之，罕有不愈者。患人忍之，数日乃说，邪气入藏，则难可制，此为家有患，备虑之要。"
 },
 {
  "iid": "康平本-独-0212",
  "页": 76,
  "类": "独立",
  "文本": "凡作汤药，不可避晨夜，觉病须臾，即宜便治，不等早晚，则易愈矣。如或差迟，病即传变，虽欲除治，必难为力。服药不如方法，纵意违师，不须治之。"
 },
 {
  "iid": "康平本-独-0213",
  "页": 76,
  "类": "独立",
  "文本": "凡伤寒之病，多从风寒得之。始表中风寒，入里则不消。然①未有温覆而当不消散者。拟欲攻之，犹当先解表，乃可下之。若表已不在证治解，而内不消，虽②非大满，犹生寒热，□□□□□，则病不除。若表已解，而内不消，大满有燥屎，自可除下之。虽四五日，不能为"
 },
 {
  "iid": "康平本-独-0214",
  "页": 76,
  "类": "独立",
  "文本": "凡两感俱作，治有先后，发表攻里，本自不同，而执迷妄意④"
 },
 {
  "iid": "康平本-独-0215",
  "页": 77,
  "类": "独立",
  "文本": "者，乃云神丹、甘遂，合而饮之，且解其表，又除其里，言巧似是，其理实违。大智者之举措也，常审以慎；愚者之动作也，必果而速。安危之变，岂可诡哉！世上士，俱务彼翕习之荣，而莫见此倾危之败，惟明者，居然能护其本，近取诸身，夫何远之有焉。"
 },
 {
  "iid": "康平本-独-0216",
  "页": 77,
  "类": "独立",
  "文本": "夫阳盛阴虚，汗之则死，下之则愈；阳虚阴盛，汗之则愈，下之则死矣。夫如是，则神丹安可以误发？甘遂何可以妄攻？虚盛之治，相背千里，吉凶之机，应若影响，岂容易哉！况桂枝下咽，阳盛即毙；承气入胃，阴盛以凶①。死生之要，在乎须臾，视身之尽，不暇计日。"
 },
 {
  "iid": "康平本-独-0217",
  "页": 77,
  "类": "独立",
  "文本": "凡发汗，温服③汤药，其方虽言日三服，若病剧不解，当促其间，若与病相阻，即便有所觉，病重者，一日一夜，当晬时观之，如可半日中尽三服。服一剂，病证犹在，故当复作本汤服之。至有不肯汗出，服三剂乃解。㊟若汗不出者，死病也。"
 },
 {
  "iid": "康平本-独-0218",
  "页": 77,
  "类": "独立",
  "文本": "凡得时气病，至五六日而渴，欲饮水，饮不能多，不当与也，何者？以腹中热尚少，不能消之。㊟便更与作病也。[例]至七八日，大渴欲饮水者，犹当依证而与之。与之令④不足，勿极意也。"
 },
 {
  "iid": "康平本-独-0219",
  "页": 77,
  "类": "独立",
  "文本": "若饮而腹满，小便不利，若喘若咳，不可与之也。若饮水⑤，忽然言能饮一斗，与五升。大汗出，是为自愈也。"
 },
 {
  "iid": "康平本-独-0220",
  "页": 77,
  "类": "独立",
  "文本": "凡得病，反能饮水，此为欲愈之病。其不晓病者，但闻病饮水自愈，小渴者，乃强而与之，因成其祸，不可复数也。"
 },
 {
  "iid": "康平本-独-0221",
  "页": 78,
  "类": "独立",
  "文本": "凡得病厥，脉动数，服汤药更迟。脉浮大减小，初躁后静，此皆愈证也。"
 },
 {
  "iid": "康平本-独-0222",
  "页": 78,
  "类": "独立",
  "文本": "凡治温病，可刺五十九穴。"
 },
 {
  "iid": "康平本-独-0223",
  "页": 78,
  "类": "独立",
  "文本": "又身之穴，三百六十有五。其三十穴，灸之有害。七十九穴，刺之为灾，并中髓也。"
 },
 {
  "iid": "康平本-独-0224",
  "页": 78,
  "类": "独立",
  "文本": "又①脉四损，三日死。平人四息，病人脉一至，名曰四损。脉五损，一日死。平人五息，病人脉一至，名曰五损。脉六损，一时死。平人六息，病人脉一至，名曰六损。脉盛身寒，得之伤寒，脉虚身热，得之伤暑。脉阴阳俱盛，大汗出，不解者，死。脉阴阳俱虚，热不止者"
 },
 {
  "iid": "康平本-独-0225",
  "页": 78,
  "类": "独立",
  "文本": "此以前是伤寒热病证候也。"
 },
 {
  "iid": "康平本-独-0226",
  "页": 78,
  "类": "独立",
  "文本": "辨大阳病② 痉湿暍㊟此三种，宜应别论，以为与"
 },
 {
  "iid": "康平本-独-0227",
  "页": 78,
  "类": "碎片",
  "文本": "仿宋所摹"
 },
 {
  "iid": "康平本-独-0228",
  "页": 78,
  "类": "独立",
  "文本": "伤寒相似，故此见之。"
 },
 {
  "iid": "康平本-独-0229",
  "页": 78,
  "类": "独立",
  "文本": "太阳病，发热无汗，反恶寒者，名曰刚痉。"
 },
 {
  "iid": "康平本-独-0230",
  "页": 78,
  "类": "独立",
  "文本": "大阳病，发汗太多，致痉③。"
 },
 {
  "iid": "康平本-独-0231",
  "页": 78,
  "类": "独立",
  "文本": "病身热足寒，颈项强急，恶寒，时头热，面赤，目脉赤，独头而摇，卒口噤，背反张者，痉病也。"
 },
 {
  "iid": "康平本-独-0232",
  "页": 78,
  "类": "独立",
  "文本": "大阳病，关节疼痛而烦，脉沉而细者，名④中湿。"
 },
 {
  "iid": "康平本-独-0233",
  "页": 78,
  "类": "独立",
  "文本": "湿痹之候，其人小便不利，大便反快，但当其利小便。"
 },
 {
  "iid": "康平本-独-0234",
  "页": 79,
  "类": "独立",
  "文本": "湿家之为病，一身尽痛①，发热，身色如薰黄。"
 },
 {
  "iid": "康平本-独-0235",
  "页": 79,
  "类": "独立",
  "文本": "湿家，其人头汗出②，背强，欲得被覆向火，若下之早，则噦，胸满，小便不利，舌上如胎③，渴欲得水而不能饮，口燥渴也④。"
 },
 {
  "iid": "康平本-独-0236",
  "页": 79,
  "类": "独立",
  "文本": "丹田有热，胃中有寒。"
 },
 {
  "iid": "康平本-独-0237",
  "页": 79,
  "类": "独立",
  "文本": "湿家下之，额上汗出，微喘，小便利者，死。若下利不止者，亦死。"
 },
 {
  "iid": "康平本-独-0238",
  "页": 79,
  "类": "独立",
  "文本": "问曰：风湿相搏，一身尽疼痛，法当汗出而解。医曰："
 },
 {
  "iid": "康平本-独-0239",
  "页": 79,
  "类": "独立",
  "文本": "值天阴雨未止。"
 },
 {
  "iid": "康平本-独-0240",
  "页": 79,
  "类": "独立",
  "文本": "此可汗，汗之病不愈者，何也？答曰：发其汗，汗大出者，但风气去，湿气在，是故不愈也。"
 },
 {
  "iid": "康平本-独-0241",
  "页": 79,
  "类": "独立",
  "文本": "若治风湿者，发其汗，微微⑤□似欲汗出者，风湿俱去也。"
 },
 {
  "iid": "康平本-独-0242",
  "页": 79,
  "类": "独立",
  "文本": "病在头，中寒湿，故鼻塞。"
 },
 {
  "iid": "康平本-独-0243",
  "页": 79,
  "类": "独立",
  "文本": "太阳中热者，暍是也。其人汗出恶寒，身热而渴也。"
 },
 {
  "iid": "康平本-独-0244",
  "页": 79,
  "类": "独立",
  "文本": "太阳中暍者，身热疼重，而脉微弱。㊟此亦以夏月伤冷水，水行皮中所致也。"
 },
 {
  "iid": "康平本-独-0245",
  "页": 79,
  "类": "独立",
  "文本": "太阳中暍者，发热恶寒，身重而疼痛，其脉弦细，小便已，洒洒然毛耸，手足逆冷，小有劳，身则热，口开，前板齿燥。"
 },
 {
  "iid": "康平本-独-0246",
  "页": 79,
  "类": "独立",
  "文本": "若发汗，则恶寒甚。加温针，则发热甚。下之⑥，则淋甚。"
 },
 {
  "iid": "康平本-独-0247",
  "页": 79,
  "类": "碎片",
  "文本": "辨太阳病"
 },
 {
  "iid": "康平本-独-0248",
  "页": 79,
  "类": "重出",
  "宋本": 1,
  "覆盖": 1.0,
  "文本": "太阳之为病，脉浮，头项强痛而恶寒。"
 },
 {
  "iid": "康平本-独-0249",
  "页": 81,
  "类": "独立",
  "文本": "服一剂尽，病证犹在者，更作服。若汗不出，乃服至二三剂。禁生冷、粘滑、肉面、五辛、酒酪、臭恶等物。"
 },
 {
  "iid": "康平本-独-0250",
  "页": 81,
  "类": "碎片",
  "文本": "---"
 },
 {
  "iid": "康平本-独-0251",
  "页": 82,
  "类": "独立",
  "文本": "桂枝去芍药加附子汤"
 },
 {
  "iid": "康平本-独-0252",
  "页": 82,
  "类": "独立",
  "文本": "前方加附子一枚。"
 },
 {
  "iid": "康平本-独-0253",
  "页": 82,
  "类": "独立",
  "文本": "炮，去皮，破八片"
 },
 {
  "iid": "康平本-独-0254",
  "页": 83,
  "类": "独立",
  "文本": "桂枝二越婢一汤"
 },
 {
  "iid": "康平本-独-0255",
  "页": 84,
  "类": "碎片",
  "文本": "术汤"
 },
 {
  "iid": "康平本-独-0256",
  "页": 84,
  "类": "碎片",
  "文本": "────────────────────"
 },
 {
  "iid": "康平本-独-0257",
  "页": 85,
  "类": "碎片",
  "文本": "辨太阳病"
 },
 {
  "iid": "康平本-独-0258",
  "页": 85,
  "类": "碎片",
  "文本": "黄芩汤③主之。"
 },
 {
  "iid": "康平本-独-0259",
  "页": 86,
  "类": "碎片",
  "文本": "此为逆也"
 },
 {
  "iid": "康平本-独-0260",
  "页": 86,
  "类": "独立",
