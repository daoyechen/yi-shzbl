 },
 {
  "iid": "康平本-独-0008",
  "页": 60,
  "类": "前置",
  "文本": "本书底本取自日本康平三年丹波雅忠藏本，后经昭和丁丑年大家先生本复刻，嗣后传入我国，于1947年叶橘泉先生再将大家先生本复刻。今为保持原书面貌，均将大家眉注删去。"
 },
 {
  "iid": "康平本-独-0009",
  "页": 60,
  "类": "前置",
  "文本": "因改横排本，故将“右”，一律改为“上”。对假借字、古俗字等，一律改为通用字，其中：脉沈改脉沉、鱿改蛔、评改谵、茵蔯蒿改茵陈蒿等。个别明显错刻之字，已改正。凡□缺字，则根据宋本、或其他版本、或前后文义而补阙。"
 },
 {
  "iid": "康平本-独-0010",
  "页": 60,
  "类": "前置",
  "文本": "原书为每页16行，行字有15字、14字、13字三种，叶氏复刻本改为每页24行，行字改为27字、26字、25字三种，实质为15字（27字）为顶格，14字（26字）为降一字格，13字（25字）为降二字格。今改横排本（大32开本）为每页28行、每"
 },
 {
  "iid": "康平本-独-0011",
  "页": 60,
  "类": "前置",
  "文本": "原书夹注，现改排在正文下方以小字标出。附注及嵌注仍按原书格式改成横排。"
 },
 {
  "iid": "康平本-独-0012",
  "页": 60,
  "类": "前置",
  "文本": "本书“例言”和“目次”是后加的，为查阅方便，保留之。"
 },
 {
  "iid": "康平本-独-0013",
  "页": 60,
  "类": "前置",
  "文本": "叶氏复刻本有前序、后跋数篇，非原书之序、跋，今删去。"
 },
 {
  "iid": "康平本-独-0014",
  "页": 61,
  "类": "前置",
  "文本": "例  言"
 },
 {
  "iid": "康平本-独-0015",
  "页": 61,
  "类": "前置",
  "文本": "一、本书题曰《康平伤寒论》，又别有称《和气氏古本伤寒论》者，共是同文异题。盖康平①中丹波雅忠②跋卷尾，厥后三百余年，贞和③中和气嗣成④跋其次，所以有是题名。"
 },
 {
  "iid": "康平本-独-0016",
  "页": 61,
  "类": "前置",
  "文本": "一、在昔，方技家之有道也，会乎意、传乎神、存术其人，故虽有书传，非得心授，则不能通晓其用。《传》云：汉时张仲景，集成医方药术，及至魏晋之代，其子弟散居湖江之间，岐径支分，渐丧真传。于是晋太医令王叔和撰次之，以传于世。撰次者谓撰叙以承续其次也"
 },
 {
  "iid": "康平本-独-0017",
  "页": 61,
  "类": "前置",
  "文本": "一、晋宋之史，已记我通聘之事，及李唐兴，经史百家之学术多入于我，而医方药术渐致其盛矣。按：延历⑤ 弘仁⑥ 之际，和气清麻吕⑦ 以一国之耆宿，好学重医，以其采邑供大学之资，建文库搜集经史百家书，子孙承及，延喜⑧ 之后，显于医者甚多，与国医丹波"
 },
 {
  "iid": "康平本-独-0018",
  "页": 61,
  "类": "前置",
  "文本": "一、晚唐五季之间，方技百家多丧其传，虽有书传，谬妄伪托不"
 },
 {
  "iid": "康平本-独-0019",
  "页": 61,
  "类": "前置",
  "文本": "--------------------------------------------------------------------------------"
 },
 {
  "iid": "康平本-独-0020",
  "页": 61,
  "类": "前置",
  "文本": "① 康平：日本年号，为后冷泉天皇纪年，自1058年至1064年。相当于我国宋仁宗嘉祐纪年。"
 },
 {
  "iid": "康平本-独-0021",
  "页": 61,
  "类": "前置",
  "文本": "② 丹波雅忠：日本后冷泉天皇康平年间的御医。"
 },
 {
  "iid": "康平本-独-0022",
  "页": 61,
  "类": "前置",
  "文本": "③ 贞和：日本年号，为光严天皇纪年（1345～1347年）。相当于我国元代末期，至正五年～七年。"
 },
 {
  "iid": "康平本-独-0023",
  "页": 61,
  "类": "前置",
  "文本": "④ 和气嗣成：日本医药学家。和气清麻吕家族的后代。"
 },
 {
  "iid": "康平本-独-0024",
  "页": 61,
  "类": "前置",
  "文本": "⑤ 延历：日本年号，为桓武天皇纪年中782～805年。"
 },
 {
  "iid": "康平本-独-0025",
  "页": 61,
  "类": "前置",
  "文本": "⑥ 弘仁：日本年号，为嵯峨天皇纪年中810～822年。"
 },
 {
  "iid": "康平本-独-0026",
  "页": 61,
  "类": "前置",
  "文本": "⑦ 和气清麻吕：和气嗣成的先祖。详见“《康平本伤寒论》考”文。"
 },
 {
  "iid": "康平本-独-0027",
  "页": 61,
  "类": "前置",
  "文本": "⑧ 延喜：日本年号，为醍醐天皇纪年中910～922年。"
 },
 {
  "iid": "康平本-独-0028",
  "页": 62,
  "类": "前置",
  "文本": "足置信，迨赵宋之时，古书之纂修补订大起，乃开宝①中，高继仲②编录《伤寒论》，后英宗③命儒臣纂修医籍，高保衡、孙奇、林亿等，校定《伤寒论》，其书今不传，后世以明赵开美所梓行者，称诸宋本，固非有信据也；又别有金人成无己之注解本，称《成本伤寒论》"
 },
 {
  "iid": "康平本-独-0029",
  "页": 62,
  "类": "前置",
  "文本": "一、国朝庆元④之后，明人舶载医药百家书者渐多，然医家皆难读解，及明医郑一元来长崎讲习诊方药术、《金匮》、《千金》、《脉经》、《外台》之诸书，大行于世，从是读诵讲论竞起，然《金匮玉函经》虽谓前唐之遗典，对较诸《千金翼方》，则或同其引例，几不留"
 },
 {
  "iid": "康平本-独-0030",
  "页": 62,
  "类": "前置",
  "文本": "一、本书之传来，在大宝⑤以前耶？将在天平⑥以后耶？固不可考之。然袭藏传写以及康平之时，依然存其古态式，一丁⑦十六行，行十五字，间有十四字及十三字，嵌注、旁书极分明，阙字以☐示之，自足窥晋代之遗型。予今参较之宋后之诸本，其旁书、嵌注多混入本文"
 },
 {
  "iid": "康平本-独-0031",
  "页": 62,
  "类": "前置",
  "文本": "------------------------"
 },
 {
  "iid": "康平本-独-0032",
  "页": 62,
  "类": "前置",
  "文本": "① 开宝：宋太祖赵匡胤年号，自968年至976年。"
 },
 {
  "iid": "康平本-独-0033",
  "页": 62,
  "类": "前置",
  "文本": "② 高继仲：即高雄冲，详见《高继冲本伤寒论》注。"
 },
 {
  "iid": "康平本-独-0034",
  "页": 62,
  "类": "前置",
  "文本": "③ 英宗：宋英宗赵曙（1064~1067年）。"
 },
 {
  "iid": "康平本-独-0035",
  "页": 62,
  "类": "前置",
  "文本": "④ 庆元：南宋宋宁宗赵扩年号（1195~1200年）。"
 },
 {
  "iid": "康平本-独-0036",
  "页": 62,
  "类": "前置",
  "文本": "⑤ 大宝：日本年号，为文武天皇纪年中701~703年。相当于唐武则天大足元年至长安三年。"
 },
 {
  "iid": "康平本-独-0037",
  "页": 62,
  "类": "前置",
  "文本": "⑥ 天平：日本年号，为孝谦天皇纪年中729~748年。相当于唐玄宗开元年代。"
 },
 {
  "iid": "康平本-独-0038",
  "页": 62,
  "类": "前置",
  "文本": "⑦ 一丁：一张。古代线装书正面和背面为对折一张，称一页。现代书为二页。"
 },
 {
  "iid": "康平本-独-0039",
  "页": 63,
  "类": "前置",
  "文本": "一、辨脉法、平脉法、及辨不可发汗病脉证并治，以下诸篇，注家多是为王叔和所增益，然本书不揭此诸篇，乃可知增益之者非叔和而为后世人也；又诸本皆太阳病作太阳病、回逆汤作四逆汤、玄武汤作真武汤之类颇多，且章句或有增损、或剩、或鸩、一一辨之栏外。"
 },
 {
  "iid": "康平本-独-0040",
  "页": 63,
  "类": "前置",
  "文本": "一、本书之刻，专在存古态式，故行数、字数、旁书、嵌注，一莫所改审，但加之句读、添《目次》者，予之婆心供初学之便而已。"
 },
 {
  "iid": "康平本-独-0041",
  "页": 63,
  "类": "前置",
  "文本": "一、上栏随便，以本书称原本，随俗称以赵开美梓行本称《宋本》，以成无己注本称《成本》，以《金匮玉函经》称《玉函》，以《金匮要略》称《金匮》，而称坊本者坊间伤寒论之杂籍也。"
 },
 {
  "iid": "康平本-独-0042",
  "页": 63,
  "类": "前置",
  "文本": "一、本书系川越①利根川尚方氏②遗藏，予获之参较他家藏本一部，及《和气氏古本伤寒论》二部，皆是传写之旧本，子午亥豕之讹，修订难尽，博雅君子幸谅之。闻利根川尚方氏，幕末之人，有《国玉医则》、《神遗方发挥》之著，以和方为一家云。"
 },
 {
  "iid": "康平本-独-0043",
  "页": 63,
  "类": "前置",
  "文本": "昭和丁丑③立春"
